// Smart HR Enterprise — database schema.
//
// Conventions (see docs/decisions/0002-tenancy-and-rls.md):
// - Every tenant-owned table has `tenant_id uuid not null` and a row-level security policy.
// - IDs are UUIDv7, generated by the client (`@default(uuid(7))`).
// - Timestamps are timestamptz in UTC. Business dates use `@db.Date`. Money uses `@db.Decimal(19, 4)`.
// - Table and column names are snake_case via @@map / @map.
// - RLS policies and grants live in hand-written migrations; Prisma does not model them.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  OFFBOARDING
  ARCHIVED

  @@map("tenant_status")
}

/// A customer organisation. In dedicated and in-house deployments there is exactly one.
model Tenant {
  id            String             @id @default(uuid(7)) @db.Uuid
  slug          String             @unique
  name          String
  status        TenantStatus       @default(ACTIVE)
  /// Organisation policy: every member must turn on two-step verification before using the organisation.
  requireMfa    Boolean            @default(false) @map("require_mfa")
  /// Branding shown in the app; null = Smart HR defaults.
  brandName     String?            @map("brand_name")
  /// Hex colour for buttons and highlights; checked for contrast with white text before it is stored.
  brandColor    String?            @map("brand_color")
  /// https URL of a logo image.
  brandLogoUrl  String?            @map("brand_logo_url")
  /// Set when offboarding starts: members keep read-only access and can export; nothing can be changed.
  offboardingAt DateTime?          @map("offboarding_at") @db.Timestamptz(6)
  archivedAt    DateTime?          @map("archived_at") @db.Timestamptz(6)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  settings      TenantSetting[]
  memberships   TenantMembership[]
  sessions      UserSession[]
  companies     Company[]
  roles         Role[]
  notifications Notification[]
  lookupValues  LookupValue[]
  subscription  Subscription?

  employees               Employee[]
  shifts                  Shift[]
  shiftAssignments        ShiftAssignment[]
  attendancePunches       AttendancePunch[]
  biometricDevices        BiometricDevice[]
  vendors                 Vendor[]
  expenseCategories       ExpenseCategory[]
  expenseClaims           ExpenseClaim[]
  expenseLines            ExpenseLine[]
  purchaseRequests        PurchaseRequest[]
  purchaseRequestLines    PurchaseRequestLine[]
  purchaseOrders          PurchaseOrder[]
  purchaseOrderLines      PurchaseOrderLine[]
  goodsReceipts           GoodsReceipt[]
  goodsReceiptLines       GoodsReceiptLine[]
  assets                  Asset[]
  assetAssignments        AssetAssignment[]
  warehouses              Warehouse[]
  inventoryItems          InventoryItem[]
  stockMovements          StockMovement[]
  projects                Project[]
  projectMembers          ProjectMember[]
  timeEntries             TimeEntry[]
  opsWorkspaces           OpsWorkspace[]
  opsStages               OpsStage[]
  opsFields               OpsField[]
  opsItems                OpsItem[]
  opsItemEvents           OpsItemEvent[]
  aiUsageEvents           AiUsageEvent[]
  apiKeys                 ApiKey[]
  webhookEndpoints        WebhookEndpoint[]
  webhookDeliveries       WebhookDelivery[]
  biometricEnrollments    BiometricEnrollment[]
  biometricLogs           BiometricLog[]
  attendanceDays          AttendanceDay[]
  attendanceCorrections   AttendanceCorrection[]
  holidayCalendars        HolidayCalendar[]
  holidays                Holiday[]
  leaveTypes              LeaveType[]
  leaveLedger             LeaveLedgerEntry[]
  leaveRequests           LeaveRequest[]
  employeeChanges         EmployeeChangeRequest[]
  storedFiles             StoredFile[]
  employeeDocuments       EmployeeDocument[]
  letterTemplates         LetterTemplate[]
  signatureRequests       SignatureRequest[]
  signatureSigners        SignatureSigner[]
  jobOpenings             JobOpening[]
  candidates              Candidate[]
  jobApplications         JobApplication[]
  applicationEvents       ApplicationEvent[]
  interviews              Interview[]
  interviewFeedback       InterviewFeedback[]
  jobOffers               JobOffer[]
  onboardingTemplates     OnboardingTemplate[]
  onboardingTemplateTasks OnboardingTemplateTask[]
  onboardingPlans         OnboardingPlan[]
  onboardingTasks         OnboardingTask[]
  payComponents           PayComponent[]
  employeeSalaries        EmployeeSalary[]
  employeePayrolls        EmployeePayroll[]
  payrollSettings         PayrollSetting[]
  professionalTaxTables   ProfessionalTaxTable[]
  payrollRuns             PayrollRun[]
  payslips                Payslip[]
  ledgerAccounts          LedgerAccount[]
  customers               Customer[]
  invoiceTemplates        InvoiceTemplate[]
  salesSettings           SalesSetting[]
  salesDocuments          SalesDocument[]
  salesDocumentLines      SalesDocumentLine[]
  customerReceipts        CustomerReceipt[]
  receiptAllocations      ReceiptAllocation[]
  journalEntries          JournalEntry[]
  journalLines            JournalLine[]
  bookLocks               BookLock[]

  @@map("tenant")
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED

  @@map("membership_status")
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED

  @@map("audit_outcome")
}

enum TokenPurpose {
  PASSWORD_RESET
  INVITATION

  @@map("token_purpose")
}

/// Organisation records are archived, never deleted, so history and references stay intact.
enum RecordStatus {
  ACTIVE
  ARCHIVED

  @@map("record_status")
}

/// Where a role assignment applies. TENANT covers everything; COMPANY covers its branches and departments;
/// DEPARTMENT covers its sub-departments.
enum ScopeType {
  TENANT
  COMPANY
  BRANCH
  DEPARTMENT

  @@map("scope_type")
}

/// A login identity. Global, not tenant-owned: one person can belong to several tenants.
/// Deliberately separate from the employee record (Phase 8), which a user may later be linked to.
model User {
  id                   String                @id @default(uuid(7)) @db.Uuid
  /// Normalised to lower case before storage.
  email                String                @unique
  displayName          String                @map("display_name")
  /// argon2id hash. Null for SSO-only accounts.
  passwordHash         String?               @map("password_hash")
  status               UserStatus            @default(ACTIVE)
  isPlatformAdmin      Boolean               @default(false) @map("is_platform_admin")
  failedLoginCount     Int                   @default(0) @map("failed_login_count")
  lockedUntil          DateTime?             @map("locked_until") @db.Timestamptz(6)
  passwordChangedAt    DateTime?             @map("password_changed_at") @db.Timestamptz(6)
  lastLoginAt          DateTime?             @map("last_login_at") @db.Timestamptz(6)
  /// AES-256-GCM ciphertext of the TOTP secret; never stored in plain text.
  mfaTotpSecret        String?               @map("mfa_totp_secret")
  /// Secret awaiting confirmation during enrolment.
  mfaTotpPendingSecret String?               @map("mfa_totp_pending_secret")
  /// Last accepted TOTP time step, to reject replayed codes.
  mfaTotpLastStep      BigInt?               @map("mfa_totp_last_step")
  mfaEnabledAt         DateTime?             @map("mfa_enabled_at") @db.Timestamptz(6)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships          TenantMembership[]
  sessions             UserSession[]
  passwordResetTokens  PasswordResetToken[]
  recoveryCodes        MfaRecoveryCode[]
  notifications        Notification[]
  installedLicences    InstallationLicence[]

  @@map("app_user")
}

/// Grants a user access to a tenant. `isTenantAdmin` marks an organisation owner, who holds every permission;
/// everyone else gets permissions through role assignments.
model TenantMembership {
  id                  String               @id @default(uuid(7)) @db.Uuid
  tenantId            String               @map("tenant_id") @db.Uuid
  userId              String               @map("user_id") @db.Uuid
  status              MembershipStatus     @default(ACTIVE)
  isTenantAdmin       Boolean              @default(false) @map("is_tenant_admin")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments         RoleAssignment[]
  approvalRequests    ApprovalRequest[]    @relation("ApprovalRequester")
  approvalTasks       ApprovalTask[]       @relation("ApprovalAssignee")
  delegationsGiven    ApprovalDelegation[] @relation("DelegationFrom")
  delegationsReceived ApprovalDelegation[] @relation("DelegationTo")

  employee Employee?

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([userId])
  @@map("tenant_membership")
}

/// A legal entity inside a tenant.
model Company {
  id           String       @id @default(uuid(7)) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  code         String
  name         String
  legalName    String?      @map("legal_name")
  /// ISO 3166-1 alpha-2.
  country      String       @db.Char(2)
  /// ISO 4217.
  baseCurrency String       @map("base_currency") @db.Char(3)
  /// IANA time zone id, e.g. Asia/Kolkata.
  timezone     String
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branches     Branch[]
  departments  Department[]

  holidayCalendars HolidayCalendar[]
  employees        Employee[]
  jobOpenings      JobOpening[]
  payrollSetting   PayrollSetting[]
  payrollRuns      PayrollRun[]
  ledgerAccounts   LedgerAccount[]
  journalEntries   JournalEntry[]
  bookLock         BookLock[]
  salesSettings    SalesSetting[]
  salesDocuments   SalesDocument[]
  receipts         CustomerReceipt[]
  purchaseOrders   PurchaseOrder[]
  assets           Asset[]
  warehouses       Warehouse[]
  projects         Project[]
  opsWorkspaces    OpsWorkspace[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@map("company")
}

/// A location of a company. References are tenant-qualified, so a branch can never point at another tenant's company.
model Branch {
  id        String       @id @default(uuid(7)) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  companyId String       @map("company_id") @db.Uuid
  code      String
  name      String
  city      String?
  /// ISO 3166-1 alpha-2.
  country   String?      @db.Char(2)
  /// IANA time zone id; defaults to the company's when not set.
  timezone  String?
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  company   Company      @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)

  holidayCalendars HolidayCalendar[]
  employees        Employee[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, companyId])
  @@map("branch")
}

/// A department of a company, optionally nested under a parent department of the same company.
model Department {
  id        String       @id @default(uuid(7)) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  companyId String       @map("company_id") @db.Uuid
  parentId  String?      @map("parent_id") @db.Uuid
  code      String
  name      String
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  company   Company      @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  parent    Department?  @relation("DepartmentTree", fields: [tenantId, parentId], references: [tenantId, id], onDelete: Restrict)
  children  Department[] @relation("DepartmentTree")

  employees Employee[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, companyId])
  @@index([tenantId, parentId])
  @@map("department")
}

/// A named set of permissions. System roles are created for every tenant and cannot be edited or deleted.
model Role {
  id          String           @id @default(uuid(7)) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  /// Stable machine name, unique in the tenant.
  key         String
  name        String
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  assignments RoleAssignment[]

  @@unique([tenantId, key])
  @@unique([tenantId, id])
  @@map("role")
}

/// One permission code in a role. Codes come from the catalogue in @smart-hr/shared and are validated by the API.
model RolePermission {
  tenantId   String @map("tenant_id") @db.Uuid
  roleId     String @map("role_id") @db.Uuid
  permission String
  role       Role   @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@id([roleId, permission])
  @@index([tenantId])
  @@map("role_permission")
}

/// Gives a member a role within a scope. For TENANT scope, scope_id is the tenant id.
model RoleAssignment {
  id              String           @id @default(uuid(7)) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  membershipId    String           @map("membership_id") @db.Uuid
  roleId          String           @map("role_id") @db.Uuid
  scopeType       ScopeType        @map("scope_type")
  scopeId         String           @map("scope_id") @db.Uuid
  createdByUserId String?          @map("created_by_user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  membership      TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  role            Role             @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)

  @@unique([membershipId, roleId, scopeType, scopeId])
  @@index([tenantId, roleId])
  @@map("role_assignment")
}

/// A server-side session. The browser holds only an opaque random token; this row holds its SHA-256 hash.
model UserSession {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  /// Synchronizer token for CSRF protection, echoed by the browser in a header.
  csrfToken         String    @map("csrf_token")
  activeTenantId    String?   @map("active_tenant_id") @db.Uuid
  /// True between a correct password and a correct second factor; such a session can do nothing else.
  mfaPending        Boolean   @default(false) @map("mfa_pending")
  reauthenticatedAt DateTime? @map("reauthenticated_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason      String?   @map("revoke_reason")
  ipAddress         String?   @map("ip_address")
  userAgent         String?   @map("user_agent")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeTenant      Tenant?   @relation(fields: [activeTenantId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("user_session")
}

/// Single-use token to set a password: a reset link, or an invitation to a new account. Only the SHA-256 hash is stored.
model PasswordResetToken {
  id        String       @id @default(uuid(7)) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  purpose   TokenPurpose @default(PASSWORD_RESET)
  tokenHash String       @unique @map("token_hash")
  expiresAt DateTime     @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?    @map("used_at") @db.Timestamptz(6)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_token")
}

/// Single-use MFA recovery code. Only the SHA-256 hash is stored.
model MfaRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_code")
}

/// Append-only record of security and business events. No foreign keys: audit outlives the records it describes.
/// UPDATE and DELETE are revoked from the runtime role and blocked by a trigger.
model AuditEvent {
  id          String       @id @default(uuid(7)) @db.Uuid
  occurredAt  DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(6)
  /// Null for platform-level events such as sign-in, which happen before a tenant is chosen.
  tenantId    String?      @map("tenant_id") @db.Uuid
  actorUserId String?      @map("actor_user_id") @db.Uuid
  action      String
  outcome     AuditOutcome
  targetType  String?      @map("target_type")
  targetId    String?      @map("target_id")
  ipAddress   String?      @map("ip_address")
  userAgent   String?      @map("user_agent")
  requestId   String?      @map("request_id")
  metadata    Json         @default("{}")

  @@index([tenantId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("audit_event")
}

/// Per-tenant configuration values. The first tenant-scoped table, used to prove RLS from day one.
model TenantSetting {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, key])
  @@map("tenant_setting")
}

// ---------------------------------------------------------------------------------------------
// Phase 4: notifications and the approval engine
// ---------------------------------------------------------------------------------------------

enum EmailDeliveryStatus {
  NOT_REQUESTED
  PENDING
  SENT
  FAILED

  @@map("email_delivery_status")
}

/// In-app notification for one person in one organisation. The row is also the email outbox: it is written in
/// the same transaction as the event, and the worker claims PENDING rows, so no email is lost if a process dies.
model Notification {
  id              String              @id @default(uuid(7)) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  recipientUserId String              @map("recipient_user_id") @db.Uuid
  category        String
  title           String
  body            String
  /// Relative path in the web app, e.g. /approvals/…
  link            String?
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt          DateTime?           @map("read_at") @db.Timestamptz(6)
  emailStatus     EmailDeliveryStatus @default(NOT_REQUESTED) @map("email_status")
  /// Snapshot of the recipient address when the notification was created.
  emailTo         String?             @map("email_to")
  emailSubject    String?             @map("email_subject")
  emailText       String?             @map("email_text")
  emailAttempts   Int                 @default(0) @map("email_attempts")
  emailClaimedAt  DateTime?           @map("email_claimed_at") @db.Timestamptz(6)
  emailSentAt     DateTime?           @map("email_sent_at") @db.Timestamptz(6)
  emailLastError  String?             @map("email_last_error")
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  recipient       User                @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([tenantId, recipientUserId, createdAt])
  @@index([emailStatus, emailClaimedAt])
  @@map("notification")
}

/// Per person, per organisation and category: whether to also send email. Absent row = default for the category.
model NotificationPreference {
  tenantId     String  @map("tenant_id") @db.Uuid
  userId       String  @map("user_id") @db.Uuid
  category     String
  emailEnabled Boolean @map("email_enabled")

  @@id([tenantId, userId, category])
  @@map("notification_preference")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  CANCELLED

  @@map("approval_status")
}

enum ApprovalTaskStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  SKIPPED
  CANCELLED

  @@map("approval_task_status")
}

/// A versioned approval policy for one kind of request. Published versions are never edited; a change creates
/// a new version and requests keep the version they started with.
model ApprovalPolicy {
  id              String            @id @default(uuid(7)) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  subjectType     String            @map("subject_type")
  version         Int
  name            String
  isActive        Boolean           @default(true) @map("is_active")
  /// Stages, approver rules and thresholds; validated by @smart-hr/validation before it is stored.
  definition      Json
  createdByUserId String?           @map("created_by_user_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  requests        ApprovalRequest[]

  @@unique([tenantId, subjectType, version])
  @@unique([tenantId, id])
  @@map("approval_policy")
}

/// One thing awaiting a decision, e.g. a leave request. Modules submit through the approval service.
model ApprovalRequest {
  id                      String           @id @default(uuid(7)) @db.Uuid
  tenantId                String           @map("tenant_id") @db.Uuid
  policyId                String           @map("policy_id") @db.Uuid
  subjectType             String           @map("subject_type")
  subjectId               String           @map("subject_id")
  title                   String
  amount                  Decimal?         @db.Decimal(19, 4)
  currency                String?          @db.Char(3)
  /// Where the subject sits in the organisation; approvers are resolved for this scope.
  scopeType               ScopeType        @map("scope_type")
  scopeId                 String           @map("scope_id") @db.Uuid
  requestedByMembershipId String           @map("requested_by_membership_id") @db.Uuid
  /// The employee the request is about, when there is one; "reporting manager" approvers are found from it.
  subjectEmployeeId       String?          @map("subject_employee_id") @db.Uuid
  status                  ApprovalStatus   @default(PENDING)
  /// Index into the policy's stages; meaningful while PENDING.
  currentStage            Int              @default(0) @map("current_stage")
  /// Increments when a returned request is resubmitted.
  round                   Int              @default(1)
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  decidedAt               DateTime?        @map("decided_at") @db.Timestamptz(6)
  policy                  ApprovalPolicy   @relation(fields: [tenantId, policyId], references: [tenantId, id], onDelete: Restrict)
  requestedBy             TenantMembership @relation("ApprovalRequester", fields: [tenantId, requestedByMembershipId], references: [tenantId, id], onDelete: Restrict)
  subjectEmployee         Employee?        @relation(fields: [tenantId, subjectEmployeeId], references: [tenantId, id], onDelete: Restrict)
  tasks                   ApprovalTask[]

  /// A subject has at most one approval request.
  @@unique([tenantId, subjectType, subjectId])
  @@unique([tenantId, id])
  @@index([tenantId, requestedByMembershipId, createdAt])
  @@index([tenantId, status])
  @@map("approval_request")
}

/// One approver's decision slot in one stage of a request.
model ApprovalTask {
  id                        String             @id @default(uuid(7)) @db.Uuid
  tenantId                  String             @map("tenant_id") @db.Uuid
  requestId                 String             @map("request_id") @db.Uuid
  round                     Int
  stage                     Int
  stageName                 String             @map("stage_name")
  assigneeMembershipId      String             @map("assignee_membership_id") @db.Uuid
  /// Set when the original approver had delegated to the assignee.
  delegatedFromMembershipId String?            @map("delegated_from_membership_id") @db.Uuid
  status                    ApprovalTaskStatus @default(PENDING)
  actedByMembershipId       String?            @map("acted_by_membership_id") @db.Uuid
  actedAt                   DateTime?          @map("acted_at") @db.Timestamptz(6)
  comment                   String?
  dueAt                     DateTime?          @map("due_at") @db.Timestamptz(6)
  escalatedAt               DateTime?          @map("escalated_at") @db.Timestamptz(6)
  createdAt                 DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  request                   ApprovalRequest    @relation(fields: [tenantId, requestId], references: [tenantId, id], onDelete: Cascade)
  assignee                  TenantMembership   @relation("ApprovalAssignee", fields: [tenantId, assigneeMembershipId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, assigneeMembershipId, status])
  @@index([tenantId, requestId])
  @@index([status, dueAt])
  @@map("approval_task")
}

/// "While I'm away, my approvals go to …". Applies to tasks created during the period.
model ApprovalDelegation {
  id               String           @id @default(uuid(7)) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  fromMembershipId String           @map("from_membership_id") @db.Uuid
  toMembershipId   String           @map("to_membership_id") @db.Uuid
  startsAt         DateTime         @map("starts_at") @db.Timestamptz(6)
  endsAt           DateTime         @map("ends_at") @db.Timestamptz(6)
  reason           String?
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt        DateTime?        @map("revoked_at") @db.Timestamptz(6)
  from             TenantMembership @relation("DelegationFrom", fields: [tenantId, fromMembershipId], references: [tenantId, id], onDelete: Cascade)
  to               TenantMembership @relation("DelegationTo", fields: [tenantId, toMembershipId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, fromMembershipId])
  @@map("approval_delegation")
}

// ---------------------------------------------------------------------------------------------
// Phase 4: master data

/// A value in one of the organisation's reference lists (employment types, designations, grades, …).
/// The lists themselves are defined in code (`MASTER_DATA_LISTS`); values are archived, never deleted,
/// so records that use them keep their meaning.
model LookupValue {
  id          String       @id @default(uuid(7)) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  list        String
  code        String
  name        String
  description String?
  sortOrder   Int          @default(0) @map("sort_order")
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  designationOf    Employee[] @relation("EmployeeDesignation")
  gradeOf          Employee[] @relation("EmployeeGrade")
  employmentTypeOf Employee[] @relation("EmployeeEmploymentType")
  costCentreOf     Employee[] @relation("EmployeeCostCentre")
  exitReasonOf     Employee[] @relation("EmployeeExitReason")

  @@unique([tenantId, list, code])
  @@unique([tenantId, id])
  @@index([tenantId, list, status, sortOrder])
  @@map("lookup_value")
}

// ---------------------------------------------------------------------------------------------
// Phase 5: plans, subscriptions and entitlements
//
// The catalogue (plan, plan_version, plan_price, addon, addon_price) is global platform data, written only
// by platform operators. A published plan version is immutable — a database trigger refuses changes — so a
// subscription always means what it meant when it was sold. Subscriptions and everything attached to them
// are tenant-owned and isolated by row-level security.
// ---------------------------------------------------------------------------------------------

enum PlanVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED

  @@map("plan_version_status")
}

enum BillingPeriod {
  MONTHLY
  ANNUAL

  @@map("billing_period")
}

enum PricingModel {
  PER_USER
  PER_EMPLOYEE
  FLAT

  @@map("pricing_model")
}

enum AddonKind {
  FEATURE
  CAPACITY
  SERVICE

  @@map("addon_kind")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  SUSPENDED
  EXPIRED

  @@map("subscription_status")
}

enum EntitlementOverrideKind {
  FEATURE
  LIMIT

  @@map("entitlement_override_kind")
}

/// A product plan, e.g. Pro. What it includes lives in its versions.
model Plan {
  id          String        @id @default(uuid(7)) @db.Uuid
  /// Stable code, e.g. PRO.
  code        String        @unique
  name        String
  description String?
  sortOrder   Int           @default(0) @map("sort_order")
  status      RecordStatus  @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  versions    PlanVersion[]

  @@map("plan")
}

/// One version of a plan's contents. Drafts are edited; published versions are frozen; retired versions are
/// no longer sold but keep serving existing subscriptions.
model PlanVersion {
  id               String            @id @default(uuid(7)) @db.Uuid
  planId           String            @map("plan_id") @db.Uuid
  version          Int
  status           PlanVersionStatus @default(DRAFT)
  /// Feature codes from @smart-hr/entitlements.
  features         String[]
  /// Limit code → number, or null for unlimited.
  limits           Json              @default("{}")
  trialDays        Int               @default(0) @map("trial_days")
  graceDays        Int               @default(14) @map("grace_days")
  supportLevel     String            @default("STANDARD") @map("support_level")
  /// SAAS, DEDICATED, IN_HOUSE.
  deploymentModels String[]          @map("deployment_models")
  notes            String?
  createdByUserId  String?           @map("created_by_user_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  publishedAt      DateTime?         @map("published_at") @db.Timestamptz(6)
  retiredAt        DateTime?         @map("retired_at") @db.Timestamptz(6)
  plan             Plan              @relation(fields: [planId], references: [id], onDelete: Restrict)
  prices           PlanPrice[]
  subscriptions    Subscription[]
  checkoutOrders   CheckoutOrder[]

  @@unique([planId, version])
  @@map("plan_version")
}

/// A list price for a plan version. Prices are set by operators; nothing is hard-coded.
model PlanPrice {
  id            String        @id @default(uuid(7)) @db.Uuid
  planVersionId String        @map("plan_version_id") @db.Uuid
  /// ISO 4217.
  currency      String        @db.Char(3)
  billingPeriod BillingPeriod @map("billing_period")
  pricingModel  PricingModel  @map("pricing_model")
  amount        Decimal       @db.Decimal(19, 4)
  planVersion   PlanVersion   @relation(fields: [planVersionId], references: [id], onDelete: Cascade)

  @@unique([planVersionId, currency, billingPeriod])
  @@map("plan_price")
}

/// Something sold on top of a plan: extra features, extra capacity, or a service (e.g. dedicated hosting).
model Addon {
  id            String              @id @default(uuid(7)) @db.Uuid
  code          String              @unique
  name          String
  description   String?
  kind          AddonKind
  features      String[]
  /// Limit increments per unit of quantity; null makes the limit unlimited.
  limits        Json                @default("{}")
  status        RecordStatus        @default(ACTIVE)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  prices        AddonPrice[]
  subscriptions SubscriptionAddon[]

  @@map("addon")
}

model AddonPrice {
  id            String        @id @default(uuid(7)) @db.Uuid
  addonId       String        @map("addon_id") @db.Uuid
  currency      String        @db.Char(3)
  billingPeriod BillingPeriod @map("billing_period")
  pricingModel  PricingModel  @map("pricing_model")
  amount        Decimal       @db.Decimal(19, 4)
  addon         Addon         @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@unique([addonId, currency, billingPeriod])
  @@map("addon_price")
}

/// The organisation's current subscription. Changes are recorded in subscription_event.
model Subscription {
  id                 String              @id @default(uuid(7)) @db.Uuid
  tenantId           String              @unique @map("tenant_id") @db.Uuid
  planVersionId      String              @map("plan_version_id") @db.Uuid
  status             SubscriptionStatus
  billingPeriod      BillingPeriod       @default(MONTHLY) @map("billing_period")
  currency           String              @default("INR") @db.Char(3)
  trialEndsAt        DateTime?           @map("trial_ends_at") @db.Timestamptz(6)
  currentPeriodStart DateTime?           @map("current_period_start") @db.Timestamptz(6)
  /// Null = open-ended (e.g. an annual contract invoiced offline and renewed by an operator).
  currentPeriodEnd   DateTime?           @map("current_period_end") @db.Timestamptz(6)
  graceEndsAt        DateTime?           @map("grace_ends_at") @db.Timestamptz(6)
  /// Employees this licence covers (per-employee sales). Null = only the plan's own employee limit applies.
  licensedEmployees  Int?                @map("licensed_employees")
  cancelledAt        DateTime?           @map("cancelled_at") @db.Timestamptz(6)
  /// Billing provider, e.g. `manual`. Card data is never stored here.
  provider           String              @default("manual")
  providerRef        String?             @map("provider_ref")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  planVersion        PlanVersion         @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  addons             SubscriptionAddon[]

  @@unique([tenantId, id])
  @@map("subscription")
}

model SubscriptionAddon {
  id             String       @id @default(uuid(7)) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  subscriptionId String       @map("subscription_id") @db.Uuid
  addonId        String       @map("addon_id") @db.Uuid
  quantity       Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  subscription   Subscription @relation(fields: [tenantId, subscriptionId], references: [tenantId, id], onDelete: Cascade)
  addon          Addon        @relation(fields: [addonId], references: [id], onDelete: Restrict)

  @@unique([subscriptionId, addonId])
  @@index([tenantId])
  @@map("subscription_addon")
}

/// A sales or support exception for one organisation: grant or remove a feature, or set a limit.
model EntitlementOverride {
  id              String                  @id @default(uuid(7)) @db.Uuid
  tenantId        String                  @map("tenant_id") @db.Uuid
  kind            EntitlementOverrideKind
  key             String
  /// FEATURE overrides: grant (true) or remove (false).
  enabled         Boolean?
  /// LIMIT overrides: exact value; null = unlimited.
  value           Int?
  reason          String
  expiresAt       DateTime?               @map("expires_at") @db.Timestamptz(6)
  createdByUserId String?                 @map("created_by_user_id") @db.Uuid
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt       DateTime?               @map("revoked_at") @db.Timestamptz(6)

  @@index([tenantId])
  @@map("entitlement_override")
}

/// Append-only history of subscription changes: the billing audit trail.
model SubscriptionEvent {
  id            String              @id @default(uuid(7)) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  action        String
  fromStatus    SubscriptionStatus? @map("from_status")
  toStatus      SubscriptionStatus? @map("to_status")
  planVersionId String?             @map("plan_version_id") @db.Uuid
  actorUserId   String?             @map("actor_user_id") @db.Uuid
  details       Json                @default("{}")
  occurredAt    DateTime            @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([tenantId, occurredAt])
  @@map("subscription_event")
}

// ---------------------------------------------------------------------------------------------
// Phase 6: self-service sign-up
// ---------------------------------------------------------------------------------------------

/// A pending self-service sign-up. Nothing is created until the person proves they own the email address by
/// opening the emailed link; only the SHA-256 hash of the link's token is stored.
model SignupRequest {
  id               String    @id @default(uuid(7)) @db.Uuid
  email            String
  displayName      String    @map("display_name")
  organisationName String    @map("organisation_name")
  tokenHash        String    @unique @map("token_hash")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(6)
  tenantId         String?   @map("tenant_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email])
  @@map("signup_request")
}

enum CheckoutStatus {
  PENDING
  PAID

  @@map("checkout_status")
}

/// A purchase started on the website: who is buying what, and the payment provider's order for it. Rows exist
/// before any organisation does, so only platform actors (the checkout service) can see or write them. When the
/// payment is confirmed, the organisation is created and `tenantId` is set. Card data never reaches us.
model CheckoutOrder {
  id                String         @id @default(uuid(7)) @db.Uuid
  email             String
  displayName       String         @map("display_name")
  organisationName  String         @map("organisation_name")
  planVersionId     String         @map("plan_version_id") @db.Uuid
  billingPeriod     BillingPeriod  @map("billing_period")
  /// Members or employees, for per-unit pricing; 1 for flat pricing.
  quantity          Int            @default(1)
  /// Set when the price is per employee: becomes the organisation's employee limit.
  licensedEmployees Int?           @map("licensed_employees")
  currency          String         @db.Char(3)
  /// In the currency's smallest unit (paise for INR).
  amountMinor       Int            @map("amount_minor")
  provider          String         @default("razorpay")
  providerOrderId   String         @unique @map("provider_order_id")
  providerPaymentId String?        @unique @map("provider_payment_id")
  status            CheckoutStatus @default(PENDING)
  tenantId          String?        @map("tenant_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  paidAt            DateTime?      @map("paid_at") @db.Timestamptz(6)
  planVersion       PlanVersion    @relation(fields: [planVersionId], references: [id], onDelete: Restrict)

  @@index([email])
  @@map("checkout_order")
}

/// One row per installation, created by the migration. Its id binds an in-house licence to this installation.
model Installation {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("installation")
}

/// Signed licences installed on an in-house installation. The newest one without replaced_at applies.
model InstallationLicence {
  id                String    @id @default(uuid(7)) @db.Uuid
  licenceId         String    @unique @map("licence_id") @db.Uuid
  /// The signed licence exactly as issued; re-verified on every read.
  token             String
  customerName      String    @map("customer_name")
  planCode          String    @map("plan_code")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  installedAt       DateTime  @default(now()) @map("installed_at") @db.Timestamptz(6)
  installedByUserId String?   @map("installed_by_user_id") @db.Uuid
  replacedAt        DateTime? @map("replaced_at") @db.Timestamptz(6)

  installedBy User? @relation(fields: [installedByUserId], references: [id], onDelete: SetNull)

  @@index([replacedAt])
  @@map("installation_licence")
}

// ---------------------------------------------------------------------------------------------
// Phase 8: employees
// ---------------------------------------------------------------------------------------------

enum EmployeeStatus {
  ACTIVE
  /// Resigned or given notice; still employed until the last working day.
  ON_NOTICE
  EXITED

  @@map("employee_status")
}

enum Gender {
  FEMALE
  MALE
  NON_BINARY
  UNDISCLOSED

  @@map("gender")
}

enum EmployeeEventKind {
  JOINED
  TRANSFER
  PROMOTION
  MANAGER_CHANGE
  NOTICE
  NOTICE_WITHDRAWN
  EXIT

  @@map("employee_event_kind")
}

/// A person employed by one of the tenant's companies. Not every employee signs in: `membershipId` links
/// the record to a sign-in account when they have one. Every reference is tenant-qualified.
model Employee {
  id               String         @id @default(uuid(7)) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  employeeCode     String         @map("employee_code")
  membershipId     String?        @map("membership_id") @db.Uuid
  firstName        String         @map("first_name")
  lastName         String         @map("last_name")
  preferredName    String?        @map("preferred_name")
  workEmail        String?        @map("work_email")
  personalEmail    String?        @map("personal_email")
  phone            String?
  dateOfBirth      DateTime?      @map("date_of_birth") @db.Date
  gender           Gender?
  companyId        String         @map("company_id") @db.Uuid
  branchId         String?        @map("branch_id") @db.Uuid
  departmentId     String?        @map("department_id") @db.Uuid
  designationId    String?        @map("designation_id") @db.Uuid
  gradeId          String?        @map("grade_id") @db.Uuid
  employmentTypeId String?        @map("employment_type_id") @db.Uuid
  costCentreId     String?        @map("cost_centre_id") @db.Uuid
  managerId        String?        @map("manager_id") @db.Uuid
  dateOfJoining    DateTime       @map("date_of_joining") @db.Date
  probationEndDate DateTime?      @map("probation_end_date") @db.Date
  status           EmployeeStatus @default(ACTIVE)
  noticeGivenOn    DateTime?      @map("notice_given_on") @db.Date
  lastWorkingDay   DateTime?      @map("last_working_day") @db.Date
  exitReasonId     String?        @map("exit_reason_id") @db.Uuid
  exitedOn         DateTime?      @map("exited_on") @db.Date
  /// Optimistic concurrency: an update must name the version it was based on.
  version          Int            @default(1)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant                Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membership            TenantMembership?       @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict)
  company               Company                 @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  branch                Branch?                 @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  department            Department?             @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict)
  designation           LookupValue?            @relation("EmployeeDesignation", fields: [tenantId, designationId], references: [tenantId, id], onDelete: Restrict)
  grade                 LookupValue?            @relation("EmployeeGrade", fields: [tenantId, gradeId], references: [tenantId, id], onDelete: Restrict)
  employmentType        LookupValue?            @relation("EmployeeEmploymentType", fields: [tenantId, employmentTypeId], references: [tenantId, id], onDelete: Restrict)
  costCentre            LookupValue?            @relation("EmployeeCostCentre", fields: [tenantId, costCentreId], references: [tenantId, id], onDelete: Restrict)
  exitReason            LookupValue?            @relation("EmployeeExitReason", fields: [tenantId, exitReasonId], references: [tenantId, id], onDelete: Restrict)
  manager               Employee?               @relation("EmployeeManager", fields: [tenantId, managerId], references: [tenantId, id], onDelete: Restrict)
  reports               Employee[]              @relation("EmployeeManager")
  sensitive             EmployeeSensitive?
  events                EmployeeEvent[]
  emergencyContacts     EmergencyContact[]
  shiftAssignments      ShiftAssignment[]
  attendancePunches     AttendancePunch[]
  biometricEnrollment   BiometricEnrollment?
  expenseClaims         ExpenseClaim[]
  purchaseRequests      PurchaseRequest[]
  assetAssignments      AssetAssignment[]
  biometricLogs         BiometricLog[]
  attendanceDays        AttendanceDay[]
  attendanceCorrections AttendanceCorrection[]
  leaveLedger           LeaveLedgerEntry[]
  changeRequests        EmployeeChangeRequest[]
  documents             EmployeeDocument[]
  onboardingPlans       OnboardingPlan[]
  hiredFrom             JobApplication[]
  salaries              EmployeeSalary[]
  payrollProfile        EmployeePayroll[]
  payslips              Payslip[]
  leaveRequests         LeaveRequest[]
  approvalRequests      ApprovalRequest[]
  managedProjects       Project[]               @relation("ProjectManager")
  projectMemberships    ProjectMember[]
  timeEntries           TimeEntry[]
  opsItems              OpsItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, employeeCode])
  @@unique([tenantId, membershipId])
  @@unique([tenantId, workEmail])
  @@index([tenantId, status])
  @@index([tenantId, companyId])
  @@index([tenantId, branchId])
  @@index([tenantId, departmentId])
  @@index([tenantId, managerId])
  @@map("employee")
}

/// Identity and bank details. Numbers are encrypted (AES-256-GCM, bound to the employee and field); only
/// the last four characters are stored in clear, for masked display.
model EmployeeSensitive {
  employeeId        String   @id @map("employee_id") @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  panSealed         String?  @map("pan_sealed")
  panLast4          String?  @map("pan_last4")
  aadhaarSealed     String?  @map("aadhaar_sealed")
  aadhaarLast4      String?  @map("aadhaar_last4")
  bankAccountSealed String?  @map("bank_account_sealed")
  bankAccountLast4  String?  @map("bank_account_last4")
  bankIfsc          String?  @map("bank_ifsc")
  bankName          String?  @map("bank_name")
  uan               String?
  updatedByUserId   String?  @map("updated_by_user_id") @db.Uuid
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, employeeId])
  @@map("employee_sensitive")
}

/// Append-only employment history: joining, transfers, promotions, manager changes, notice and exit.
model EmployeeEvent {
  id            String            @id @default(uuid(7)) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  employeeId    String            @map("employee_id") @db.Uuid
  kind          EmployeeEventKind
  effectiveDate DateTime          @map("effective_date") @db.Date
  /// Field → { from, to } with display names, as they were at the time.
  changes       Json              @default("{}")
  note          String?
  actorUserId   String?           @map("actor_user_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, employeeId, effectiveDate])
  @@map("employee_event")
}

model EmergencyContact {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  name         String
  relationship String
  phone        String
  email        String?
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, employeeId])
  @@map("emergency_contact")
}

/// Next automatic employee number per organisation (EMP-0001, EMP-0002, …).
model EmployeeCounter {
  tenantId   String @id @map("tenant_id") @db.Uuid
  nextNumber Int    @default(1) @map("next_number")

  @@map("employee_counter")
}

// ---- Attendance (Phase 9) ---------------------------------------------------------------------------

enum AttendanceDayStatus {
  PRESENT
  HALF_DAY
  ABSENT
  WEEKLY_OFF
  HOLIDAY
  ON_LEAVE

  @@map("attendance_day_status")
}

enum PunchDirection {
  IN
  OUT

  @@map("punch_direction")
}

enum PunchSource {
  /// The employee, from the web app.
  WEB
  /// Entered by someone with attendance.manage on the employee's behalf.
  ADMIN
  /// Written when a correction is approved.
  CORRECTION
  /// Uploaded from a file or a device export.
  IMPORT
  /// Pushed by a biometric attendance machine.
  DEVICE

  @@map("punch_source")
}

enum AttendanceCorrectionStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  CANCELLED

  @@map("attendance_correction_status")
}

/// A working pattern. Times are minutes after local midnight in the employee's time zone; an end before the
/// start means the shift crosses midnight.
model Shift {
  id             String       @id @default(uuid(7)) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  code           String
  name           String
  startMinute    Int          @map("start_minute")
  endMinute      Int          @map("end_minute")
  breakMinutes   Int          @default(0) @map("break_minutes")
  /// Arriving within this many minutes of the start isn't late.
  graceMinutes   Int          @default(10) @map("grace_minutes")
  /// Worked minutes needed for a half day and a full day.
  halfDayMinutes Int          @default(240) @map("half_day_minutes")
  fullDayMinutes Int          @default(480) @map("full_day_minutes")
  /// Days of the week that are off: 0 = Sunday … 6 = Saturday.
  weeklyOffs     Int[]        @default([0]) @map("weekly_offs")
  /// Used for employees with no assignment.
  isDefault      Boolean      @default(false) @map("is_default")
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assignments ShiftAssignment[]
  days        AttendanceDay[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("shift")
}

/// Which shift an employee works from a date onwards. The latest assignment on or before a day applies.
model ShiftAssignment {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  employeeId      String   @map("employee_id") @db.Uuid
  shiftId         String   @map("shift_id") @db.Uuid
  effectiveFrom   DateTime @map("effective_from") @db.Date
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)
  shift    Shift    @relation(fields: [tenantId, shiftId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, employeeId, effectiveFrom])
  @@index([tenantId, shiftId])
  @@map("shift_assignment")
}

/// One clock-in or clock-out. Append-only: mistakes are fixed by an approved correction, never by editing.
model AttendancePunch {
  id               String         @id @default(uuid(7)) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  employeeId       String         @map("employee_id") @db.Uuid
  at               DateTime       @db.Timestamptz(6)
  direction        PunchDirection
  source           PunchSource
  note             String?
  recordedByUserId String?        @map("recorded_by_user_id") @db.Uuid
  correctionId     String?        @map("correction_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee   Employee              @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)
  correction AttendanceCorrection? @relation(fields: [tenantId, correctionId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, employeeId, at])
  @@map("attendance_punch")
}

/// The computed result for one employee and local date. Recomputed whenever its punches, corrections or shift
/// change; days without a row are read as absent (working day in the past) or weekly off.
model AttendanceDay {
  id                String              @id @default(uuid(7)) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  employeeId        String              @map("employee_id") @db.Uuid
  date              DateTime            @db.Date
  shiftId           String?             @map("shift_id") @db.Uuid
  status            AttendanceDayStatus
  firstIn           DateTime?           @map("first_in") @db.Timestamptz(6)
  lastOut           DateTime?           @map("last_out") @db.Timestamptz(6)
  workedMinutes     Int                 @default(0) @map("worked_minutes")
  lateMinutes       Int                 @default(0) @map("late_minutes")
  earlyLeaveMinutes Int                 @default(0) @map("early_leave_minutes")
  overtimeMinutes   Int                 @default(0) @map("overtime_minutes")
  /// An approved correction contributed to this day.
  corrected         Boolean             @default(false)
  computedAt        DateTime            @default(now()) @map("computed_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)
  shift    Shift?   @relation(fields: [tenantId, shiftId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, employeeId, date])
  @@index([tenantId, date])
  @@map("attendance_day")
}

enum BiometricVendor {
  ESSL
  ZKTECO

  @@map("biometric_vendor")
}

enum BiometricLogOutcome {
  /// Became a clock-in or clock-out.
  IMPORTED
  /// The device's user number isn't linked to an employee yet; applied once it is.
  UNMAPPED
  /// A second scan within a minute of the last one.
  DUPLICATE
  /// The employee has left, or the punch could not be placed.
  REJECTED

  @@map("biometric_log_outcome")
}

/// A fingerprint, face or card machine that pushes its scans to us. It is recognised by its serial number.
model BiometricDevice {
  id           String          @id @default(uuid(7)) @db.Uuid
  tenantId     String          @map("tenant_id") @db.Uuid
  name         String
  vendor       BiometricVendor @default(ESSL)
  serialNumber String          @unique @map("serial_number")
  location     String?
  /// The machine's clock is local time; this says which time zone it is in.
  timeZone     String          @default("Asia/Kolkata") @map("time_zone")
  status       RecordStatus    @default(ACTIVE)
  lastSeenAt   DateTime?       @map("last_seen_at") @db.Timestamptz(6)
  lastPunchAt  DateTime?       @map("last_punch_at") @db.Timestamptz(6)
  /// The last upload marker the machine sent, handed back so it doesn't resend old scans.
  attlogStamp  String?         @map("attlog_stamp")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  logs   BiometricLog[]

  @@unique([tenantId, id])
  @@map("biometric_device")
}

/// Links the user number enrolled on the machines to an employee. One number per employee, organisation-wide.
model BiometricEnrollment {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  deviceCode String   @map("device_code")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, deviceCode])
  @@unique([tenantId, employeeId])
  @@map("biometric_enrollment")
}

/// Every scan a machine sent, kept as received. Uploading the same scan twice is harmless.
model BiometricLog {
  id         String              @id @default(uuid(7)) @db.Uuid
  tenantId   String              @map("tenant_id") @db.Uuid
  deviceId   String              @map("device_id") @db.Uuid
  deviceCode String              @map("device_code")
  punchedAt  DateTime            @map("punched_at") @db.Timestamptz(6)
  rawStatus  Int?                @map("raw_status")
  verifyMode Int?                @map("verify_mode")
  outcome    BiometricLogOutcome
  employeeId String?             @map("employee_id") @db.Uuid
  receivedAt DateTime            @default(now()) @map("received_at") @db.Timestamptz(6)

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  device   BiometricDevice @relation(fields: [tenantId, deviceId], references: [tenantId, id], onDelete: Restrict)
  employee Employee?       @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)

  @@unique([deviceId, deviceCode, punchedAt])
  @@index([tenantId, outcome])
  @@index([tenantId, receivedAt])
  @@map("biometric_log")
}

/// A request to fix a day's times (a forgotten clock-out, a device failure). Applied only once approved.
model AttendanceCorrection {
  id                String                     @id @default(uuid(7)) @db.Uuid
  tenantId          String                     @map("tenant_id") @db.Uuid
  employeeId        String                     @map("employee_id") @db.Uuid
  date              DateTime                   @db.Date
  inAt              DateTime?                  @map("in_at") @db.Timestamptz(6)
  outAt             DateTime?                  @map("out_at") @db.Timestamptz(6)
  reason            String
  status            AttendanceCorrectionStatus @default(PENDING)
  approvalRequestId String?                    @map("approval_request_id") @db.Uuid
  requestedByUserId String                     @map("requested_by_user_id") @db.Uuid
  decisionNote      String?                    @map("decision_note")
  decidedAt         DateTime?                  @map("decided_at") @db.Timestamptz(6)
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee Employee          @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)
  punches  AttendancePunch[]

  @@unique([tenantId, id])
  @@index([tenantId, employeeId, date])
  @@index([tenantId, status])
  @@map("attendance_correction")
}

// ---- Holidays and leave (Phase 10) ------------------------------------------------------------------

enum LeaveAccrual {
  /// The year's quota is credited at the start of the year (pro-rated for people who join during it).
  YEARLY
  /// One twelfth of the quota is credited each month.
  MONTHLY
  /// No balance is kept (for example unpaid leave); only requests and approvals.
  NONE

  @@map("leave_accrual")
}

enum LeaveLedgerKind {
  GRANT
  ACCRUAL
  CARRY_FORWARD
  LAPSE
  ADJUSTMENT
  TAKEN
  REVERSAL

  @@map("leave_ledger_kind")
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  CANCELLED

  @@map("leave_request_status")
}

enum HalfDay {
  FIRST_HALF
  SECOND_HALF

  @@map("half_day")
}

/// A set of public holidays. One calendar per place: the whole organisation, a company or a branch. An
/// employee follows their branch's calendar, else their company's, else the organisation's.
model HolidayCalendar {
  id        String       @id @default(uuid(7)) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  name      String
  companyId String?      @map("company_id") @db.Uuid
  branchId  String?      @map("branch_id") @db.Uuid
  /// "TENANT", "COMPANY:<id>" or "BRANCH:<id>": makes "one calendar per place" a unique constraint.
  scopeKey  String       @map("scope_key")
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company  Company?  @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  branch   Branch?   @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  holidays Holiday[]

  @@unique([tenantId, id])
  @@unique([tenantId, scopeKey])
  @@map("holiday_calendar")
}

model Holiday {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  calendarId String   @map("calendar_id") @db.Uuid
  date       DateTime @db.Date
  name       String
  /// A restricted holiday: shown on the calendar, but a working day unless the employee takes leave.
  optional   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  calendar HolidayCalendar @relation(fields: [tenantId, calendarId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, calendarId, date])
  @@index([tenantId, date])
  @@map("holiday")
}

model LeaveType {
  id                    String       @id @default(uuid(7)) @db.Uuid
  tenantId              String       @map("tenant_id") @db.Uuid
  code                  String
  name                  String
  description           String?
  paid                  Boolean      @default(true)
  accrual               LeaveAccrual @default(YEARLY)
  /// Days per year (YEARLY and MONTHLY).
  quotaDays             Decimal      @default(0) @map("quota_days") @db.Decimal(5, 1)
  /// Unused days that move into the next year; the rest lapse.
  carryForwardMaxDays   Decimal      @default(0) @map("carry_forward_max_days") @db.Decimal(5, 1)
  allowHalfDay          Boolean      @default(true) @map("allow_half_day")
  /// Count weekly offs and holidays inside a request as leave days.
  includeNonWorkingDays Boolean      @default(false) @map("include_non_working_days")
  /// Requests for oneself must be made this many days ahead (0 = any time, including afterwards).
  minNoticeDays         Int          @default(0) @map("min_notice_days")
  /// Longest single request in days; null = no limit.
  maxDaysPerRequest     Int?         @map("max_days_per_request")
  status                RecordStatus @default(ACTIVE)
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  ledger   LeaveLedgerEntry[]
  requests LeaveRequest[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("leave_type")
}

/// Every change to a leave balance, append-only. A balance is the sum of its year's entries.
model LeaveLedgerEntry {
  id              String          @id @default(uuid(7)) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  employeeId      String          @map("employee_id") @db.Uuid
  leaveTypeId     String          @map("leave_type_id") @db.Uuid
  year            Int
  kind            LeaveLedgerKind
  /// Positive credits, negative debits, in days (half days allowed).
  days            Decimal         @db.Decimal(6, 1)
  /// Makes automatic credits idempotent: "2026" for a yearly grant, "2026-03" for March's accrual.
  periodKey       String?         @map("period_key")
  requestId       String?         @map("request_id") @db.Uuid
  note            String?
  createdByUserId String?         @map("created_by_user_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee  Employee      @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)
  leaveType LeaveType     @relation(fields: [tenantId, leaveTypeId], references: [tenantId, id], onDelete: Restrict)
  request   LeaveRequest? @relation(fields: [tenantId, requestId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, employeeId, leaveTypeId, kind, periodKey], map: "leave_ledger_entry_period_key_key")
  @@index([tenantId, employeeId, leaveTypeId, year])
  @@map("leave_ledger_entry")
}

model LeaveRequest {
  id                String             @id @default(uuid(7)) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  employeeId        String             @map("employee_id") @db.Uuid
  leaveTypeId       String             @map("leave_type_id") @db.Uuid
  fromDate          DateTime           @map("from_date") @db.Date
  toDate            DateTime           @map("to_date") @db.Date
  /// Only for one-day requests: which half of the day is taken.
  halfDay           HalfDay?           @map("half_day")
  days              Decimal            @db.Decimal(5, 1)
  reason            String
  status            LeaveRequestStatus @default(PENDING)
  approvalRequestId String?            @map("approval_request_id") @db.Uuid
  requestedByUserId String             @map("requested_by_user_id") @db.Uuid
  decisionNote      String?            @map("decision_note")
  decidedAt         DateTime?          @map("decided_at") @db.Timestamptz(6)
  cancelledByUserId String?            @map("cancelled_by_user_id") @db.Uuid
  cancelledAt       DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee  Employee           @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)
  leaveType LeaveType          @relation(fields: [tenantId, leaveTypeId], references: [tenantId, id], onDelete: Restrict)
  ledger    LeaveLedgerEntry[]

  @@unique([tenantId, id])
  @@index([tenantId, employeeId, fromDate])
  @@index([tenantId, status])
  @@map("leave_request")
}

// ---- Employment changes for approval (Phase 11) -----------------------------------------------------

enum EmployeeChangeStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  CANCELLED

  @@map("employee_change_status")
}

/// A promotion, transfer, manager change, notice or exit waiting for approval. Applied (and written to the
/// employee's history) only when approved; checked again at that moment.
model EmployeeChangeRequest {
  id                String               @id @default(uuid(7)) @db.Uuid
  tenantId          String               @map("tenant_id") @db.Uuid
  employeeId        String               @map("employee_id") @db.Uuid
  /// transfer, promotion, change_manager, notice, withdraw_notice or exit.
  action            String
  /// The change as requested (validated input).
  payload           Json
  /// What would change, worked out when requested: { field: { from, to } }.
  changes           Json
  effectiveDate     DateTime             @map("effective_date") @db.Date
  note              String?
  status            EmployeeChangeStatus @default(PENDING)
  approvalRequestId String?              @map("approval_request_id") @db.Uuid
  requestedByUserId String               @map("requested_by_user_id") @db.Uuid
  decisionNote      String?              @map("decision_note")
  decidedAt         DateTime?            @map("decided_at") @db.Timestamptz(6)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, employeeId, status])
  @@map("employee_change_request")
}

// ---- Documents and e-signatures (Phase 12) ---------------------------------------------------------

enum DocumentCategory {
  IDENTITY
  EDUCATION
  EMPLOYMENT
  CONTRACT
  LETTER
  POLICY
  MEDICAL
  OTHER

  @@map("document_category")
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED

  @@map("document_status")
}

enum SignatureRequestStatus {
  PENDING
  COMPLETED
  DECLINED
  CANCELLED
  EXPIRED

  @@map("signature_request_status")
}

enum SignerStatus {
  /// Signing in order, and someone before them hasn't signed yet.
  WAITING
  PENDING
  SIGNED
  DECLINED

  @@map("signer_status")
}

/// A stored file: encrypted at rest, never changed. The bytes live in object storage under `storageKey`.
model StoredFile {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  storageKey       String   @unique @map("storage_key")
  fileName         String   @map("file_name")
  mimeType         String   @map("mime_type")
  sizeBytes        Int      @map("size_bytes")
  /// SHA-256 of the plaintext, hex.
  sha256           String
  encryptionKeyId  String   @map("encryption_key_id")
  uploadedByUserId String?  @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  documents EmployeeDocument[]

  @@unique([tenantId, id])
  @@map("stored_file")
}

/// A document on an employee's record. Replacing a file means archiving the old document and adding a new one.
model EmployeeDocument {
  id                String           @id @default(uuid(7)) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  employeeId        String           @map("employee_id") @db.Uuid
  fileId            String           @map("file_id") @db.Uuid
  title             String
  category          DocumentCategory
  notes             String?
  visibleToEmployee Boolean          @default(true) @map("visible_to_employee")
  expiresOn         DateTime?        @map("expires_on") @db.Date
  /// When the expiry reminder went out (once per expiry date).
  expiryNotifiedAt  DateTime?        @map("expiry_notified_at") @db.Timestamptz(6)
  status            DocumentStatus   @default(ACTIVE)
  uploadedByUserId  String           @map("uploaded_by_user_id") @db.Uuid
  archivedAt        DateTime?        @map("archived_at") @db.Timestamptz(6)
  archivedByUserId  String?          @map("archived_by_user_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee   Employee           @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)
  file       StoredFile         @relation(fields: [tenantId, fileId], references: [tenantId, id], onDelete: Restrict)
  signatures SignatureRequest[]

  @@unique([tenantId, id])
  @@index([tenantId, employeeId, status])
  @@index([status, expiresOn])
  @@map("employee_document")
}

/// A letter template: text with {{placeholders}} filled in from an employee's record to make a PDF.
model LetterTemplate {
  id        String           @id @default(uuid(7)) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  name      String
  category  DocumentCategory @default(LETTER)
  body      String
  status    DocumentStatus   @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, name])
  @@map("letter_template")
}

/// A request for people to sign a PDF document, in order or in any order.
model SignatureRequest {
  id                String                 @id @default(uuid(7)) @db.Uuid
  tenantId          String                 @map("tenant_id") @db.Uuid
  documentId        String                 @map("document_id") @db.Uuid
  title             String
  message           String?
  sequential        Boolean                @default(true)
  status            SignatureRequestStatus @default(PENDING)
  /// SHA-256 of the document when it was sent; checked again at every signature.
  documentSha256    String                 @map("document_sha256")
  /// The signed copy (the document with its signature certificate), once everyone has signed.
  signedFileId      String?                @map("signed_file_id") @db.Uuid
  requestedByUserId String                 @map("requested_by_user_id") @db.Uuid
  expiresAt         DateTime?              @map("expires_at") @db.Timestamptz(6)
  completedAt       DateTime?              @map("completed_at") @db.Timestamptz(6)
  closedAt          DateTime?              @map("closed_at") @db.Timestamptz(6)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  document EmployeeDocument  @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Restrict)
  signers  SignatureSigner[]

  @@unique([tenantId, id])
  @@index([tenantId, documentId])
  @@index([status, expiresAt])
  @@map("signature_request")
}

/// One person asked to sign, with the evidence of their signature.
model SignatureSigner {
  id            String       @id @default(uuid(7)) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  requestId     String       @map("request_id") @db.Uuid
  position      Int
  membershipId  String       @map("membership_id") @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  name          String
  email         String
  status        SignerStatus
  signedName    String?      @map("signed_name")
  signedAt      DateTime?    @map("signed_at") @db.Timestamptz(6)
  declinedAt    DateTime?    @map("declined_at") @db.Timestamptz(6)
  declineReason String?      @map("decline_reason")
  ipAddress     String?      @map("ip_address")
  userAgent     String?      @map("user_agent")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  request SignatureRequest @relation(fields: [tenantId, requestId], references: [tenantId, id], onDelete: Restrict)

  @@unique([requestId, position])
  @@index([tenantId, userId, status])
  @@map("signature_signer")
}

// ---- Recruitment and onboarding (Phase 13) ---------------------------------------------------------

enum JobOpeningStatus {
  DRAFT
  PENDING_APPROVAL
  OPEN
  ON_HOLD
  CLOSED

  @@map("job_opening_status")
}

enum ApplicationStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN

  @@map("application_stage")
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED

  @@map("interview_status")
}

enum InterviewRecommendation {
  STRONG_YES
  YES
  NO
  STRONG_NO

  @@map("interview_recommendation")
}

enum JobOfferStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
  ACCEPTED
  DECLINED

  @@map("job_offer_status")
}

enum OnboardingAssignee {
  HR
  MANAGER
  EMPLOYEE

  @@map("onboarding_assignee")
}

enum OnboardingPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("onboarding_plan_status")
}

enum OnboardingTaskStatus {
  OPEN
  DONE
  SKIPPED

  @@map("onboarding_task_status")
}

/// A position to fill. Opened only after approval (approval subject `job_requisition`).
model JobOpening {
  id                String           @id @default(uuid(7)) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  code              String
  title             String
  companyId         String           @map("company_id") @db.Uuid
  branchId          String?          @map("branch_id") @db.Uuid
  departmentId      String?          @map("department_id") @db.Uuid
  designationId     String?          @map("designation_id") @db.Uuid
  employmentTypeId  String?          @map("employment_type_id") @db.Uuid
  hiringManagerId   String?          @map("hiring_manager_id") @db.Uuid
  positions         Int              @default(1)
  description       String
  status            JobOpeningStatus @default(DRAFT)
  approvalRequestId String?          @map("approval_request_id") @db.Uuid
  createdByUserId   String           @map("created_by_user_id") @db.Uuid
  openedAt          DateTime?        @map("opened_at") @db.Timestamptz(6)
  closedAt          DateTime?        @map("closed_at") @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company      Company          @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  applications JobApplication[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("job_opening")
}

/// Someone who applied or was sourced. One record per email in an organisation, across openings.
model Candidate {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  firstName       String   @map("first_name")
  lastName        String   @map("last_name")
  /// Lower-cased.
  email           String
  phone           String?
  source          String?
  resumeFileId    String?  @map("resume_file_id") @db.Uuid
  notes           String?
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  applications JobApplication[]

  @@unique([tenantId, id])
  @@unique([tenantId, email])
  @@map("candidate")
}

/// A candidate in one opening's pipeline.
model JobApplication {
  id              String           @id @default(uuid(7)) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  openingId       String           @map("opening_id") @db.Uuid
  candidateId     String           @map("candidate_id") @db.Uuid
  stage           ApplicationStage @default(APPLIED)
  closedReason    String?          @map("closed_reason")
  hiredEmployeeId String?          @map("hired_employee_id") @db.Uuid
  createdByUserId String           @map("created_by_user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  opening       JobOpening         @relation(fields: [tenantId, openingId], references: [tenantId, id], onDelete: Restrict)
  candidate     Candidate          @relation(fields: [tenantId, candidateId], references: [tenantId, id], onDelete: Restrict)
  hiredEmployee Employee?          @relation(fields: [tenantId, hiredEmployeeId], references: [tenantId, id], onDelete: Restrict)
  events        ApplicationEvent[]
  interviews    Interview[]
  offers        JobOffer[]

  @@unique([tenantId, id])
  @@unique([openingId, candidateId])
  @@index([tenantId, openingId, stage])
  @@map("job_application")
}

/// Append-only history of an application's stages.
model ApplicationEvent {
  id            String            @id @default(uuid(7)) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  applicationId String            @map("application_id") @db.Uuid
  fromStage     ApplicationStage? @map("from_stage")
  toStage       ApplicationStage  @map("to_stage")
  note          String?
  actorUserId   String            @map("actor_user_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  application JobApplication @relation(fields: [tenantId, applicationId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, applicationId])
  @@map("application_event")
}

model Interview {
  id              String          @id @default(uuid(7)) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  applicationId   String          @map("application_id") @db.Uuid
  title           String
  scheduledAt     DateTime        @map("scheduled_at") @db.Timestamptz(6)
  durationMinutes Int             @default(60) @map("duration_minutes")
  location        String?
  status          InterviewStatus @default(SCHEDULED)
  createdByUserId String          @map("created_by_user_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  application JobApplication      @relation(fields: [tenantId, applicationId], references: [tenantId, id], onDelete: Restrict)
  feedback    InterviewFeedback[]

  @@unique([tenantId, id])
  @@index([tenantId, applicationId])
  @@map("interview")
}

/// One interviewer's part in an interview; their feedback is final once submitted.
model InterviewFeedback {
  id             String                   @id @default(uuid(7)) @db.Uuid
  tenantId       String                   @map("tenant_id") @db.Uuid
  interviewId    String                   @map("interview_id") @db.Uuid
  membershipId   String                   @map("membership_id") @db.Uuid
  userId         String                   @map("user_id") @db.Uuid
  name           String
  rating         Int?
  recommendation InterviewRecommendation?
  comments       String?
  submittedAt    DateTime?                @map("submitted_at") @db.Timestamptz(6)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  interview Interview @relation(fields: [tenantId, interviewId], references: [tenantId, id], onDelete: Restrict)

  @@unique([interviewId, membershipId])
  @@index([tenantId, userId])
  @@map("interview_feedback")
}

/// An offer to a candidate. Approved by people (approval subject `job_offer`), then accepted or declined.
model JobOffer {
  id                String         @id @default(uuid(7)) @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  applicationId     String         @map("application_id") @db.Uuid
  designationId     String?        @map("designation_id") @db.Uuid
  joiningDate       DateTime       @map("joining_date") @db.Date
  /// Annual cost to company offered, in the company's currency.
  annualCtc         Decimal?       @map("annual_ctc") @db.Decimal(14, 2)
  currency          String?        @db.Char(3)
  notes             String?
  status            JobOfferStatus @default(PENDING_APPROVAL)
  approvalRequestId String?        @map("approval_request_id") @db.Uuid
  decisionNote      String?        @map("decision_note")
  decidedAt         DateTime?      @map("decided_at") @db.Timestamptz(6)
  respondedAt       DateTime?      @map("responded_at") @db.Timestamptz(6)
  createdByUserId   String         @map("created_by_user_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  application JobApplication @relation(fields: [tenantId, applicationId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, applicationId])
  @@map("job_offer")
}

/// A checklist used to onboard new joiners.
model OnboardingTemplate {
  id        String         @id @default(uuid(7)) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  name      String
  status    DocumentStatus @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  tasks  OnboardingTemplateTask[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@map("onboarding_template")
}

model OnboardingTemplateTask {
  id            String             @id @default(uuid(7)) @db.Uuid
  tenantId      String             @map("tenant_id") @db.Uuid
  templateId    String             @map("template_id") @db.Uuid
  position      Int
  title         String
  description   String?
  assignee      OnboardingAssignee
  /// Days from the joining date (negative = before they join).
  dueOffsetDays Int                @default(0) @map("due_offset_days")

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  template OnboardingTemplate @relation(fields: [tenantId, templateId], references: [tenantId, id], onDelete: Cascade)

  @@unique([templateId, position])
  @@map("onboarding_template_task")
}

/// One new joiner's onboarding: tasks copied from a template, each with a person and a due date.
model OnboardingPlan {
  id              String               @id @default(uuid(7)) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  employeeId      String               @map("employee_id") @db.Uuid
  templateName    String?              @map("template_name")
  startDate       DateTime             @map("start_date") @db.Date
  status          OnboardingPlanStatus @default(ACTIVE)
  createdByUserId String               @map("created_by_user_id") @db.Uuid
  completedAt     DateTime?            @map("completed_at") @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee Employee         @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)
  tasks    OnboardingTask[]

  @@unique([tenantId, id])
  @@index([tenantId, employeeId])
  @@map("onboarding_plan")
}

model OnboardingTask {
  id                String               @id @default(uuid(7)) @db.Uuid
  tenantId          String               @map("tenant_id") @db.Uuid
  planId            String               @map("plan_id") @db.Uuid
  position          Int
  title             String
  description       String?
  assignee          OnboardingAssignee
  /// Who does it, worked out when the plan was made (the employee, their manager, or the HR person).
  assigneeUserId    String?              @map("assignee_user_id") @db.Uuid
  dueDate           DateTime             @map("due_date") @db.Date
  status            OnboardingTaskStatus @default(OPEN)
  completedAt       DateTime?            @map("completed_at") @db.Timestamptz(6)
  completedByUserId String?              @map("completed_by_user_id") @db.Uuid
  note              String?
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan   OnboardingPlan @relation(fields: [tenantId, planId], references: [tenantId, id], onDelete: Restrict)

  @@unique([planId, position])
  @@index([tenantId, assigneeUserId, status])
  @@map("onboarding_task")
}

// ---- Payroll (Phase 14) ----------------------------------------------------------------------------

enum PayComponentKind {
  EARNING
  DEDUCTION

  @@map("pay_component_kind")
}

enum PayrollRunStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PAID
  CANCELLED

  @@map("payroll_run_status")
}

/// A line that can appear on a payslip: basic, HRA, special allowance, a canteen deduction, …
model PayComponent {
  id        String           @id @default(uuid(7)) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  code      String
  name      String
  kind      PayComponentKind
  taxable   Boolean          @default(true)
  /// Counts as "wages" for provident fund (basic, dearness allowance, retaining allowance).
  pfWage    Boolean          @default(false) @map("pf_wage")
  esiWage   Boolean          @default(true) @map("esi_wage")
  prorate   Boolean          @default(true)
  sortOrder Int              @default(0) @map("sort_order")
  status    RecordStatus     @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("pay_component")
}

/// An employee's pay from a date. Revisions are added, never changed.
model EmployeeSalary {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  employeeId      String   @map("employee_id") @db.Uuid
  effectiveFrom   DateTime @map("effective_from") @db.Date
  annualCtc       Decimal  @map("annual_ctc") @db.Decimal(14, 2)
  /// [{ componentId, code, name, monthly }]
  lines           Json
  note            String?
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, employeeId, effectiveFrom])
  @@map("employee_salary")
}

/// How statutory rules apply to one employee.
model EmployeePayroll {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  employeeId    String   @map("employee_id") @db.Uuid
  pfEnabled     Boolean  @default(true) @map("pf_enabled")
  /// Contribute on full wages above the ceiling (voluntary, both sides agreeing).
  pfOnFullWages Boolean  @default(false) @map("pf_on_full_wages")
  esiEnabled    Boolean  @default(true) @map("esi_enabled")
  /// State for professional tax (two-letter code), or none.
  ptState       String?  @map("pt_state")
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, employeeId])
  @@map("employee_payroll")
}

/// Statutory registrations and switches for one company.
model PayrollSetting {
  id                String   @id @default(uuid(7)) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  pfEnabled         Boolean  @default(true) @map("pf_enabled")
  esiEnabled        Boolean  @default(true) @map("esi_enabled")
  /// Count allowances above half of pay as PF wages (Code on Social Security).
  labourCodeWages   Boolean  @default(true) @map("labour_code_wages")
  pfEstablishmentId String?  @map("pf_establishment_id")
  esiEmployerCode   String?  @map("esi_employer_code")
  tan               String?
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company Company @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, companyId])
  @@map("payroll_setting")
}

/// A state's professional-tax slabs as the organisation uses them.
model ProfessionalTaxTable {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  state     String
  name      String
  /// [{ upTo, amount, february? }]
  slabs     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, state])
  @@map("professional_tax_table")
}

/// One month's payroll for one company. Approved by people before anyone is paid.
model PayrollRun {
  id                String           @id @default(uuid(7)) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  companyId         String           @map("company_id") @db.Uuid
  year              Int
  month             Int
  status            PayrollRunStatus @default(DRAFT)
  employeeCount     Int              @default(0) @map("employee_count")
  gross             Decimal          @default(0) @db.Decimal(14, 2)
  deductions        Decimal          @default(0) @db.Decimal(14, 2)
  net               Decimal          @default(0) @db.Decimal(14, 2)
  employerCost      Decimal          @default(0) @map("employer_cost") @db.Decimal(14, 2)
  approvalRequestId String?          @map("approval_request_id") @db.Uuid
  createdByUserId   String           @map("created_by_user_id") @db.Uuid
  calculatedAt      DateTime?        @map("calculated_at") @db.Timestamptz(6)
  approvedAt        DateTime?        @map("approved_at") @db.Timestamptz(6)
  paidAt            DateTime?        @map("paid_at") @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company  Company   @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  payslips Payslip[]

  @@unique([tenantId, id])
  @@index([tenantId, companyId, year, month])
  @@map("payroll_run")
}

/// One employee's pay for a run. Final once the run is approved.
model Payslip {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  runId           String   @map("run_id") @db.Uuid
  employeeId      String   @map("employee_id") @db.Uuid
  employedDays    Int      @map("employed_days")
  lopDays         Decimal  @default(0) @map("lop_days") @db.Decimal(5, 1)
  /// Loss of pay entered by hand, replacing what attendance says.
  lopOverride     Decimal? @map("lop_override") @db.Decimal(5, 1)
  paidDays        Decimal  @map("paid_days") @db.Decimal(5, 1)
  earnings        Json
  deductions      Json
  employer        Json
  adjustments     Json     @default("[]")
  gross           Decimal  @db.Decimal(14, 2)
  totalDeductions Decimal  @map("total_deductions") @db.Decimal(14, 2)
  net             Decimal  @db.Decimal(14, 2)
  employerCost    Decimal  @map("employer_cost") @db.Decimal(14, 2)
  pfWages         Decimal  @default(0) @map("pf_wages") @db.Decimal(14, 2)
  esiWages        Decimal  @default(0) @map("esi_wages") @db.Decimal(14, 2)
  esiCovered      Boolean  @default(false) @map("esi_covered")
  taxable         Decimal  @default(0) @db.Decimal(14, 2)
  tds             Json?
  warnings        Json     @default("[]")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  run      PayrollRun @relation(fields: [tenantId, runId], references: [tenantId, id], onDelete: Restrict)
  employee Employee   @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([runId, employeeId])
  @@index([tenantId, employeeId])
  @@map("payslip")
}

// ---- Finance and accounting (Phase 15) -------------------------------------------------------------

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE

  @@map("account_type")
}

enum JournalStatus {
  DRAFT
  PENDING_APPROVAL
  POSTED
  CANCELLED

  @@map("journal_status")
}

enum JournalSource {
  MANUAL
  REVERSAL
  PAYROLL
  PAYROLL_PAYMENT
  SALES_DOCUMENT
  SALES_RECEIPT

  @@map("journal_source")
}

/// An account in a company's chart of accounts.
model LedgerAccount {
  id          String       @id @default(uuid(7)) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  companyId   String       @map("company_id") @db.Uuid
  code        String
  name        String
  type        AccountType
  /// What the system posts here (salaries, PF payable, bank, …), at most one account each per company.
  systemKey   String?      @map("system_key")
  description String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company Company       @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  lines   JournalLine[]

  @@unique([tenantId, id])
  @@unique([companyId, code])
  @@unique([companyId, systemKey])
  @@map("ledger_account")
}

/// A double-entry journal. Posted journals are never changed; mistakes are reversed.
model JournalEntry {
  id                String        @id @default(uuid(7)) @db.Uuid
  tenantId          String        @map("tenant_id") @db.Uuid
  companyId         String        @map("company_id") @db.Uuid
  /// JV/2026-27/0001, given when posted.
  number            String?
  date              DateTime      @db.Date
  narration         String
  source            JournalSource @default(MANUAL)
  /// The payroll run (or other record) it came from.
  sourceId          String?       @map("source_id") @db.Uuid
  status            JournalStatus @default(DRAFT)
  total             Decimal       @default(0) @db.Decimal(16, 2)
  approvalRequestId String?       @map("approval_request_id") @db.Uuid
  reversesId        String?       @map("reverses_id") @db.Uuid
  reversedById      String?       @map("reversed_by_id") @db.Uuid
  createdByUserId   String        @map("created_by_user_id") @db.Uuid
  postedAt          DateTime?     @map("posted_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company Company       @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  lines   JournalLine[]

  @@unique([tenantId, id])
  @@unique([companyId, number])
  @@index([tenantId, companyId, status, date])
  @@index([tenantId, source, sourceId])
  @@map("journal_entry")
}

model JournalLine {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  entryId    String   @map("entry_id") @db.Uuid
  position   Int
  accountId  String   @map("account_id") @db.Uuid
  debit      Decimal  @default(0) @db.Decimal(16, 2)
  credit     Decimal  @default(0) @db.Decimal(16, 2)
  narration  String?
  employeeId String?  @map("employee_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  entry   JournalEntry  @relation(fields: [tenantId, entryId], references: [tenantId, id], onDelete: Restrict)
  account LedgerAccount @relation(fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict)

  @@unique([entryId, position])
  @@index([tenantId, accountId])
  @@map("journal_line")
}

/// Books closed up to a date: nothing can be posted on or before it.
model BookLock {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  lockedUntil     DateTime @map("locked_until") @db.Date
  updatedByUserId String   @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company Company @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, companyId])
  @@map("book_lock")
}

// ---- Vendors and expenses (Phase 16) ----------------------------------------------------------------

enum ExpenseClaimStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PAID
  CANCELLED

  @@map("expense_claim_status")
}

/// Someone the organisation buys from. Shared by every company in the organisation.
model Vendor {
  id               String       @id @default(uuid(7)) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  code             String
  name             String
  /// 15-character GST number, when registered.
  gstin            String?
  pan              String?
  contactName      String?      @map("contact_name")
  email            String?
  phone            String?
  address          String?
  paymentTermsDays Int          @default(30) @map("payment_terms_days")
  notes            String?
  status           RecordStatus @default(ACTIVE)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  purchaseOrders PurchaseOrder[]
  assets         Asset[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("vendor")
}

/// A kind of expense (Travel, Meals, …) with the rules claims in it must meet.
model ExpenseCategory {
  id              String       @id @default(uuid(7)) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  code            String
  name            String
  /// Every line in this category must carry a receipt or bill number.
  requiresReceipt Boolean      @default(false) @map("requires_receipt")
  /// Largest amount for one line; null = no limit.
  maxAmount       Decimal?     @map("max_amount") @db.Decimal(16, 2)
  status          RecordStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  lines  ExpenseLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("expense_category")
}

/// An employee's request to be paid back for money they spent. Edited only while a draft.
model ExpenseClaim {
  id                String             @id @default(uuid(7)) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  employeeId        String             @map("employee_id") @db.Uuid
  /// EXP-000001, given when first sent for approval.
  number            String?
  title             String
  status            ExpenseClaimStatus @default(DRAFT)
  total             Decimal            @default(0) @db.Decimal(16, 2)
  currency          String             @db.Char(3)
  approvalRequestId String?            @map("approval_request_id") @db.Uuid
  submittedAt       DateTime?          @map("submitted_at") @db.Timestamptz(6)
  decidedAt         DateTime?          @map("decided_at") @db.Timestamptz(6)
  decisionNote      String?            @map("decision_note")
  paidAt            DateTime?          @map("paid_at") @db.Timestamptz(6)
  paymentReference  String?            @map("payment_reference")
  paidByUserId      String?            @map("paid_by_user_id") @db.Uuid
  createdByUserId   String             @map("created_by_user_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee Employee      @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)
  lines    ExpenseLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@index([tenantId, employeeId, status])
  @@index([tenantId, status])
  @@map("expense_claim")
}

model ExpenseLine {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  claimId       String   @map("claim_id") @db.Uuid
  position      Int
  date          DateTime @db.Date
  categoryId    String   @map("category_id") @db.Uuid
  description   String
  amount        Decimal  @db.Decimal(16, 2)
  /// Receipt or bill number, when there is one.
  receiptNumber String?  @map("receipt_number")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  claim    ExpenseClaim    @relation(fields: [tenantId, claimId], references: [tenantId, id], onDelete: Cascade)
  category ExpenseCategory @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)

  @@unique([claimId, position])
  @@index([tenantId, categoryId])
  @@map("expense_line")
}

// ---- Procurement (Phase 16B) ------------------------------------------------------------------------

enum PurchaseRequestStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
  /// A purchase order has been raised from it.
  ORDERED

  @@map("purchase_request_status")
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  REJECTED
  CANCELLED

  @@map("purchase_order_status")
}

/// An employee asking for something to be bought. Approved requests can be turned into purchase orders.
model PurchaseRequest {
  id                String                @id @default(uuid(7)) @db.Uuid
  tenantId          String                @map("tenant_id") @db.Uuid
  employeeId        String                @map("employee_id") @db.Uuid
  number            String?
  title             String
  justification     String?
  status            PurchaseRequestStatus @default(DRAFT)
  estimatedTotal    Decimal               @default(0) @map("estimated_total") @db.Decimal(16, 2)
  currency          String                @db.Char(3)
  approvalRequestId String?               @map("approval_request_id") @db.Uuid
  submittedAt       DateTime?             @map("submitted_at") @db.Timestamptz(6)
  decidedAt         DateTime?             @map("decided_at") @db.Timestamptz(6)
  decisionNote      String?               @map("decision_note")
  createdByUserId   String                @map("created_by_user_id") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee Employee              @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)
  lines    PurchaseRequestLine[]
  orders   PurchaseOrder[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, employeeId])
  @@map("purchase_request")
}

model PurchaseRequestLine {
  id                 String  @id @default(uuid(7)) @db.Uuid
  tenantId           String  @map("tenant_id") @db.Uuid
  requestId          String  @map("request_id") @db.Uuid
  position           Int
  description        String
  quantity           Decimal @db.Decimal(14, 3)
  estimatedUnitPrice Decimal @map("estimated_unit_price") @db.Decimal(16, 2)

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  request PurchaseRequest @relation(fields: [tenantId, requestId], references: [tenantId, id], onDelete: Cascade)

  @@unique([requestId, position])
  @@map("purchase_request_line")
}

/// An order placed with a vendor. Approved before it is sent; goods received against it are recorded.
model PurchaseOrder {
  id                String              @id @default(uuid(7)) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  companyId         String              @map("company_id") @db.Uuid
  vendorId          String              @map("vendor_id") @db.Uuid
  requestId         String?             @map("request_id") @db.Uuid
  number            String?
  status            PurchaseOrderStatus @default(DRAFT)
  orderDate         DateTime            @map("order_date") @db.Date
  expectedDate      DateTime?           @map("expected_date") @db.Date
  terms             String?
  subtotal          Decimal             @default(0) @db.Decimal(16, 2)
  taxTotal          Decimal             @default(0) @map("tax_total") @db.Decimal(16, 2)
  total             Decimal             @default(0) @db.Decimal(16, 2)
  currency          String              @db.Char(3)
  approvalRequestId String?             @map("approval_request_id") @db.Uuid
  submittedAt       DateTime?           @map("submitted_at") @db.Timestamptz(6)
  decidedAt         DateTime?           @map("decided_at") @db.Timestamptz(6)
  decisionNote      String?             @map("decision_note")
  createdByUserId   String              @map("created_by_user_id") @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company  Company             @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  vendor   Vendor              @relation(fields: [tenantId, vendorId], references: [tenantId, id], onDelete: Restrict)
  request  PurchaseRequest?    @relation(fields: [tenantId, requestId], references: [tenantId, id], onDelete: Restrict)
  lines    PurchaseOrderLine[]
  receipts GoodsReceipt[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@index([tenantId, companyId, status])
  @@index([tenantId, vendorId])
  @@map("purchase_order")
}

model PurchaseOrderLine {
  id               String  @id @default(uuid(7)) @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  orderId          String  @map("order_id") @db.Uuid
  position         Int
  description      String
  quantity         Decimal @db.Decimal(14, 3)
  unitPrice        Decimal @map("unit_price") @db.Decimal(16, 2)
  /// GST or other tax, as a percentage.
  taxRate          Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  receivedQuantity Decimal @default(0) @map("received_quantity") @db.Decimal(14, 3)

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  order        PurchaseOrder      @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  receiptLines GoodsReceiptLine[]

  @@unique([tenantId, id])
  @@unique([orderId, position])
  @@map("purchase_order_line")
}

/// Goods that arrived against an order. Kept as received; never edited.
model GoodsReceipt {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  orderId          String   @map("order_id") @db.Uuid
  number           String
  receivedOn       DateTime @map("received_on") @db.Date
  note             String?
  receivedByUserId String   @map("received_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  order  PurchaseOrder      @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  lines  GoodsReceiptLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@index([tenantId, orderId])
  @@map("goods_receipt")
}

model GoodsReceiptLine {
  id          String  @id @default(uuid(7)) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  receiptId   String  @map("receipt_id") @db.Uuid
  orderLineId String  @map("order_line_id") @db.Uuid
  quantity    Decimal @db.Decimal(14, 3)

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  receipt   GoodsReceipt      @relation(fields: [tenantId, receiptId], references: [tenantId, id], onDelete: Cascade)
  orderLine PurchaseOrderLine @relation(fields: [tenantId, orderLineId], references: [tenantId, id], onDelete: Restrict)

  @@unique([receiptId, orderLineId])
  @@map("goods_receipt_line")
}

// ---- Assets (Phase 16C) -----------------------------------------------------------------------------

enum AssetStatus {
  IN_STOCK
  ASSIGNED
  UNDER_REPAIR
  RETIRED

  @@map("asset_status")
}

/// Something the company owns and tracks: a laptop, a chair, a vehicle. Depreciation is worked out on read.
model Asset {
  id               String      @id @default(uuid(7)) @db.Uuid
  tenantId         String      @map("tenant_id") @db.Uuid
  companyId        String      @map("company_id") @db.Uuid
  /// The asset tag stuck on the item, e.g. LAP-0042.
  tag              String
  name             String
  category         String
  serialNumber     String?     @map("serial_number")
  vendorId         String?     @map("vendor_id") @db.Uuid
  purchaseDate     DateTime    @map("purchase_date") @db.Date
  purchaseCost     Decimal     @map("purchase_cost") @db.Decimal(16, 2)
  salvageValue     Decimal     @default(0) @map("salvage_value") @db.Decimal(16, 2)
  usefulLifeMonths Int         @map("useful_life_months")
  currency         String      @db.Char(3)
  status           AssetStatus @default(IN_STOCK)
  notes            String?
  retiredOn        DateTime?   @map("retired_on") @db.Date
  retireReason     String?     @map("retire_reason")
  createdByUserId  String      @map("created_by_user_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company     Company           @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  vendor      Vendor?           @relation(fields: [tenantId, vendorId], references: [tenantId, id], onDelete: Restrict)
  assignments AssetAssignment[]

  @@unique([tenantId, id])
  @@unique([tenantId, tag])
  @@index([tenantId, companyId, status])
  @@map("asset")
}

/// Who had an asset and when. Open while returnedOn is empty; at most one open assignment per asset.
model AssetAssignment {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  assetId          String    @map("asset_id") @db.Uuid
  employeeId       String    @map("employee_id") @db.Uuid
  assignedOn       DateTime  @map("assigned_on") @db.Date
  returnedOn       DateTime? @map("returned_on") @db.Date
  conditionOut     String?   @map("condition_out")
  conditionIn      String?   @map("condition_in")
  assignedByUserId String    @map("assigned_by_user_id") @db.Uuid
  returnedByUserId String?   @map("returned_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  asset    Asset    @relation(fields: [tenantId, assetId], references: [tenantId, id], onDelete: Restrict)
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, assetId])
  @@index([tenantId, employeeId])
  @@map("asset_assignment")
}

// ---- Inventory (Phase 17A) --------------------------------------------------------------------------

enum StockMovementKind {
  RECEIPT
  ISSUE
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT

  @@map("stock_movement_kind")
}

/// A place stock is kept. Belongs to a company.
model Warehouse {
  id        String       @id @default(uuid(7)) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  companyId String       @map("company_id") @db.Uuid
  code      String
  name      String
  address   String?
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company   Company         @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  movements StockMovement[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("warehouse")
}

/// Something that is stocked: a product, a consumable, a spare part.
model InventoryItem {
  id           String       @id @default(uuid(7)) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  sku          String
  name         String
  /// How it is counted: pcs, kg, box, litre.
  unit         String
  category     String?
  /// Stock at or below this is flagged for reordering; null = never flagged.
  reorderLevel Decimal?     @map("reorder_level") @db.Decimal(14, 3)
  /// What one unit is valued at in stock reports.
  standardCost Decimal      @default(0) @map("standard_cost") @db.Decimal(16, 2)
  notes        String?
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  movements StockMovement[]

  @@unique([tenantId, id])
  @@unique([tenantId, sku])
  @@map("inventory_item")
}

/// The stock ledger: every change to stock is a row, never edited or removed. Stock on hand is the sum of
/// the quantities (positive in, negative out) and can never go below zero.
model StockMovement {
  id              String            @id @default(uuid(7)) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  itemId          String            @map("item_id") @db.Uuid
  warehouseId     String            @map("warehouse_id") @db.Uuid
  kind            StockMovementKind
  /// Signed: receipts and transfers in are positive, issues and transfers out negative.
  quantity        Decimal           @db.Decimal(14, 3)
  unitCost        Decimal?          @map("unit_cost") @db.Decimal(16, 2)
  occurredOn      DateTime          @map("occurred_on") @db.Date
  /// A document number or note that explains it: a GRN, a job, a stock count.
  reference       String?
  note            String?
  /// Ties the two halves of a transfer together.
  transferId      String?           @map("transfer_id") @db.Uuid
  createdByUserId String            @map("created_by_user_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  item      InventoryItem @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)
  warehouse Warehouse     @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, itemId, warehouseId])
  @@index([tenantId, occurredOn])
  @@index([tenantId, transferId])
  @@map("stock_movement")
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED

  @@map("project_status")
}

enum TimeEntryStatus {
  OPEN
  APPROVED

  @@map("time_entry_status")
}

/// Work done for a client or inside the company, with hours logged against it.
model Project {
  id          String        @id @default(uuid(7)) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  companyId   String        @map("company_id") @db.Uuid
  code        String
  name        String
  clientName  String?       @map("client_name")
  status      ProjectStatus @default(ACTIVE)
  billable    Boolean       @default(true)
  /// What one billable hour is worth to the client.
  hourlyRate  Decimal       @default(0) @map("hourly_rate") @db.Decimal(16, 2)
  budgetHours Decimal?      @map("budget_hours") @db.Decimal(10, 2)
  startDate   DateTime?     @map("start_date") @db.Date
  endDate     DateTime?     @map("end_date") @db.Date
  managerId   String?       @map("manager_id") @db.Uuid
  notes       String?
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company Company         @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  manager Employee?       @relation("ProjectManager", fields: [tenantId, managerId], references: [tenantId, id], onDelete: Restrict)
  members ProjectMember[]
  entries TimeEntry[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("project")
}

/// Someone who can log time on a project, and what an hour of their time costs the company.
model ProjectMember {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  costRate   Decimal  @default(0) @map("cost_rate") @db.Decimal(16, 2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project  Project  @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)

  @@unique([projectId, employeeId])
  @@index([tenantId, employeeId])
  @@map("project_member")
}

/// Time one person spent on one project on one day. Open until a project manager approves it.
model TimeEntry {
  id               String          @id @default(uuid(7)) @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  projectId        String          @map("project_id") @db.Uuid
  employeeId       String          @map("employee_id") @db.Uuid
  workDate         DateTime        @map("work_date") @db.Date
  minutes          Int
  billable         Boolean         @default(true)
  note             String?
  status           TimeEntryStatus @default(OPEN)
  approvedByUserId String?         @map("approved_by_user_id") @db.Uuid
  approvedAt       DateTime?       @map("approved_at") @db.Timestamptz(6)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project  Project  @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, employeeId, workDate])
  @@index([tenantId, projectId, workDate])
  @@map("time_entry")
}

enum OpsStageKind {
  OPEN
  DONE
  CANCELLED

  @@map("ops_stage_kind")
}

enum OpsFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  BOOLEAN

  @@map("ops_field_type")
}

enum OpsPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("ops_priority")
}

enum OpsEventKind {
  CREATED
  EDITED
  STAGE
  ASSIGNED
  COMMENT

  @@map("ops_event_kind")
}

/// A configurable place to track work: service requests, quality checks, batches. Has its own stages and fields.
model OpsWorkspace {
  id          String       @id @default(uuid(7)) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  companyId   String       @map("company_id") @db.Uuid
  code        String
  name        String
  description String?
  /// The built-in template it started from, if any.
  template    String?
  prefix      String
  nextNumber  Int          @default(1) @map("next_number")
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company Company    @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  stages  OpsStage[]
  fields  OpsField[]
  items   OpsItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("ops_workspace")
}

/// A step an item moves through. Kind says whether work is still open, finished or dropped.
model OpsStage {
  id          String       @id @default(uuid(7)) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  key         String
  label       String
  kind        OpsStageKind @default(OPEN)
  position    Int

  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  workspace OpsWorkspace @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  items     OpsItem[]

  @@unique([tenantId, id])
  @@unique([workspaceId, key])
  @@map("ops_stage")
}

/// An extra question every item in a workspace answers.
model OpsField {
  id          String       @id @default(uuid(7)) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  key         String
  label       String
  type        OpsFieldType
  required    Boolean      @default(false)
  options     Json?
  position    Int

  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  workspace OpsWorkspace @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@map("ops_field")
}

/// One piece of work in a workspace.
model OpsItem {
  id              String      @id @default(uuid(7)) @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  workspaceId     String      @map("workspace_id") @db.Uuid
  number          Int
  title           String
  description     String?
  stageId         String      @map("stage_id") @db.Uuid
  priority        OpsPriority @default(NORMAL)
  assigneeId      String?     @map("assignee_id") @db.Uuid
  dueDate         DateTime?   @map("due_date") @db.Date
  values          Json        @default("{}")
  createdByUserId String      @map("created_by_user_id") @db.Uuid
  completedAt     DateTime?   @map("completed_at") @db.Timestamptz(6)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  workspace OpsWorkspace   @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Restrict)
  stage     OpsStage       @relation(fields: [tenantId, stageId], references: [tenantId, id], onDelete: Restrict)
  assignee  Employee?      @relation(fields: [tenantId, assigneeId], references: [tenantId, id], onDelete: Restrict)
  events    OpsItemEvent[]

  @@unique([tenantId, id])
  @@unique([workspaceId, number])
  @@index([tenantId, assigneeId])
  @@index([workspaceId, stageId])
  @@map("ops_item")
}

/// What happened to an item, oldest first. Never edited or removed.
model OpsItemEvent {
  id          String       @id @default(uuid(7)) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  itemId      String       @map("item_id") @db.Uuid
  kind        OpsEventKind
  actorUserId String       @map("actor_user_id") @db.Uuid
  actorName   String       @map("actor_name")
  body        String?
  data        Json?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  item   OpsItem @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, itemId, createdAt])
  @@map("ops_item_event")
}

/// One call to the AI layer: who, for what, and how many tokens. Never holds prompts or replies.
model AiUsageEvent {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  feature      String
  model        String
  inputTokens  Int      @map("input_tokens")
  outputTokens Int      @map("output_tokens")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@map("ai_usage_event")
}

// ---- Integrations: API keys and webhooks ----------------------------------------------------------

enum WebhookStatus {
  ACTIVE
  DISABLED

  @@map("webhook_status")
}

enum WebhookDeliveryStatus {
  PENDING
  SENT
  FAILED

  @@map("webhook_delivery_status")
}

/// A key an outside system uses to read a limited set of data. Only a hash of the secret is kept; the secret is shown once.
model ApiKey {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  name            String
  /// The visible, unique start of the key, used to find it; not secret.
  prefix          String    @unique
  secretHash      String    @map("secret_hash")
  scopes          String[]
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastUsedAt      DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@map("api_key")
}

/// Where an organisation wants events sent. The signing secret is stored encrypted so deliveries can be signed.
model WebhookEndpoint {
  id              String        @id @default(uuid(7)) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  name            String
  url             String
  secretEnc       String        @map("secret_enc")
  events          String[]
  status          WebhookStatus @default(ACTIVE)
  /// Deliveries that failed for good since the last success; the endpoint is switched off when it gets too long.
  failureStreak   Int           @default(0) @map("failure_streak")
  createdByUserId String        @map("created_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  deliveries WebhookDelivery[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("webhook_endpoint")
}

/// One event queued for one endpoint, with how delivery went. Written in the same transaction as the change.
model WebhookDelivery {
  id             String                @id @default(uuid(7)) @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  endpointId     String                @map("endpoint_id") @db.Uuid
  eventId        String                @map("event_id") @db.Uuid
  eventType      String                @map("event_type")
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  claimedAt      DateTime?             @map("claimed_at") @db.Timestamptz(6)
  nextAttemptAt  DateTime              @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastStatusCode Int?                  @map("last_status_code")
  lastError      String?               @map("last_error")
  deliveredAt    DateTime?             @map("delivered_at") @db.Timestamptz(6)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  endpoint WebhookEndpoint @relation(fields: [tenantId, endpointId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, endpointId, createdAt])
  @@index([status, nextAttemptAt])
  @@map("webhook_delivery")
}

// ---- Sales and receivables ----------------------------------------------------------------------

enum SalesDocType {
  INVOICE
  QUOTATION
  PROFORMA
  CHALLAN
  CREDIT_NOTE

  @@map("sales_doc_type")
}

enum SalesDocStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED

  @@map("sales_doc_status")
}

enum PaymentMode {
  BANK
  CASH
  UPI
  CARD
  CHEQUE

  @@map("payment_mode")
}

/// Who we bill. GST state follows the first two digits of the GSTIN when there is one.
model Customer {
  id               String       @id @default(uuid(7)) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  code             String
  name             String
  gstin            String?
  pan              String?
  /// GST state code (01-38) used to choose CGST+SGST or IGST.
  stateCode        String?      @map("state_code") @db.Char(2)
  contactName      String?      @map("contact_name")
  email            String?
  phone            String?
  billingAddress   String?      @map("billing_address")
  shippingAddress  String?      @map("shipping_address")
  paymentTermsDays Int          @default(15) @map("payment_terms_days")
  notes            String?
  status           RecordStatus @default(ACTIVE)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  documents SalesDocument[]
  receipts  CustomerReceipt[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("customer")
}

/// How documents look: accent colour, which blocks show, default terms.
model InvoiceTemplate {
  id            String       @id @default(uuid(7)) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  name          String
  layout        String       @default("CLASSIC")
  accent        String       @default("#1d56c9")
  showHsn       Boolean      @default(true) @map("show_hsn")
  showGstSplit  Boolean      @default(true) @map("show_gst_split")
  showBank      Boolean      @default(true) @map("show_bank")
  showUpi       Boolean      @default(true) @map("show_upi")
  showSignatory Boolean      @default(false) @map("show_signatory")
  showPo        Boolean      @default(true) @map("show_po")
  defaultTerms  String?      @map("default_terms")
  defaultNote   String?      @map("default_note")
  isDefault     Boolean      @default(false) @map("is_default")
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  documents SalesDocument[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@map("invoice_template")
}

/// The seller's tax and bank details printed on documents, per company.
model SalesSetting {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  gstin         String?
  pan           String?
  stateCode     String?  @map("state_code") @db.Char(2)
  address       String?
  bankName      String?  @map("bank_name")
  bankAccountNo String?  @map("bank_account_no")
  bankIfsc      String?  @map("bank_ifsc")
  upiId         String?  @map("upi_id")
  signatory     String?
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company Company @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)

  @@unique([companyId])
  @@unique([tenantId, id])
  @@map("sales_setting")
}

/// An invoice, quotation, proforma, delivery challan or credit note.
model SalesDocument {
  id              String         @id @default(uuid(7)) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  companyId       String         @map("company_id") @db.Uuid
  customerId      String         @map("customer_id") @db.Uuid
  templateId      String?        @map("template_id") @db.Uuid
  type            SalesDocType
  /// Given when issued: INV/2026-27/0001.
  number          String?
  status          SalesDocStatus @default(DRAFT)
  date            DateTime       @db.Date
  dueDate         DateTime?      @map("due_date") @db.Date
  poNumber        String?        @map("po_number")
  /// GST state the supply is made to; the same as the seller's state means CGST + SGST.
  placeOfSupply   String?        @map("place_of_supply") @db.Char(2)
  note            String?
  terms           String?
  subtotal        Decimal        @default(0) @db.Decimal(16, 2)
  cgst            Decimal        @default(0) @db.Decimal(16, 2)
  sgst            Decimal        @default(0) @db.Decimal(16, 2)
  igst            Decimal        @default(0) @db.Decimal(16, 2)
  total           Decimal        @default(0) @db.Decimal(16, 2)
  /// Receipts and credit notes applied.
  settled         Decimal        @default(0) @db.Decimal(16, 2)
  /// The invoice a credit note corrects, or the quotation an invoice came from.
  relatedId       String?        @map("related_id") @db.Uuid
  journalEntryId  String?        @map("journal_entry_id") @db.Uuid
  createdByUserId String         @map("created_by_user_id") @db.Uuid
  issuedAt        DateTime?      @map("issued_at") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company     Company             @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  customer    Customer            @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  template    InvoiceTemplate?    @relation(fields: [tenantId, templateId], references: [tenantId, id], onDelete: Restrict)
  lines       SalesDocumentLine[]
  allocations ReceiptAllocation[]

  @@unique([tenantId, id])
  @@index([companyId, type, status])
  @@index([customerId])
  @@map("sales_document")
}

model SalesDocumentLine {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  documentId  String   @map("document_id") @db.Uuid
  position    Int
  description String
  hsn         String?
  quantity    Decimal  @db.Decimal(14, 3)
  unit        String?
  rate        Decimal  @db.Decimal(16, 2)
  discountPct Decimal  @default(0) @map("discount_pct") @db.Decimal(5, 2)
  gstRate     Decimal  @default(0) @map("gst_rate") @db.Decimal(5, 2)
  /// Quantity x rate less discount, before tax.
  amount      Decimal  @db.Decimal(16, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  document SalesDocument @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Restrict)

  @@unique([documentId, position])
  @@map("sales_document_line")
}

/// Money received from a customer, shared out across their invoices.
model CustomerReceipt {
  id               String      @id @default(uuid(7)) @db.Uuid
  tenantId         String      @map("tenant_id") @db.Uuid
  companyId        String      @map("company_id") @db.Uuid
  customerId       String      @map("customer_id") @db.Uuid
  number           String
  date             DateTime    @db.Date
  amount           Decimal     @db.Decimal(16, 2)
  mode             PaymentMode
  reference        String?
  note             String?
  /// Bank or cash account the money went into.
  depositAccountId String      @map("deposit_account_id") @db.Uuid
  journalEntryId   String?     @map("journal_entry_id") @db.Uuid
  createdByUserId  String      @map("created_by_user_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company     Company             @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  customer    Customer            @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  allocations ReceiptAllocation[]

  @@unique([tenantId, id])
  @@unique([companyId, number])
  @@index([customerId])
  @@map("customer_receipt")
}

model ReceiptAllocation {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  receiptId  String   @map("receipt_id") @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  amount     Decimal  @db.Decimal(16, 2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  receipt  CustomerReceipt @relation(fields: [tenantId, receiptId], references: [tenantId, id], onDelete: Restrict)
  document SalesDocument   @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Restrict)

  @@index([documentId])
  @@map("receipt_allocation")
}
