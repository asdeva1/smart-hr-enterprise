// Smart HR Enterprise — database schema.
//
// Conventions (see docs/decisions/0002-tenancy-and-rls.md):
// - Every tenant-owned table has `tenant_id uuid not null` and a row-level security policy.
// - IDs are UUIDv7, generated by the client (`@default(uuid(7))`).
// - Timestamps are timestamptz in UTC. Business dates use `@db.Date`. Money uses `@db.Decimal(19, 4)`.
// - Table and column names are snake_case via @@map / @map.
// - RLS policies and grants live in hand-written migrations; Prisma does not model them.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  OFFBOARDING
  ARCHIVED

  @@map("tenant_status")
}

/// A customer organisation. In dedicated and in-house deployments there is exactly one.
model Tenant {
  id            String             @id @default(uuid(7)) @db.Uuid
  slug          String             @unique
  name          String
  status        TenantStatus       @default(ACTIVE)
  /// Organisation policy: every member must turn on two-step verification before using the organisation.
  requireMfa    Boolean            @default(false) @map("require_mfa")
  /// Branding shown in the app; null = Smart HR defaults.
  brandName     String?            @map("brand_name")
  /// Hex colour for buttons and highlights; checked for contrast with white text before it is stored.
  brandColor    String?            @map("brand_color")
  /// https URL of a logo image.
  brandLogoUrl  String?            @map("brand_logo_url")
  /// Set when offboarding starts: members keep read-only access and can export; nothing can be changed.
  offboardingAt DateTime?          @map("offboarding_at") @db.Timestamptz(6)
  archivedAt    DateTime?          @map("archived_at") @db.Timestamptz(6)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  settings      TenantSetting[]
  memberships   TenantMembership[]
  sessions      UserSession[]
  companies     Company[]
  roles         Role[]
  notifications Notification[]
  lookupValues  LookupValue[]
  subscription  Subscription?

  employees             Employee[]
  shifts                Shift[]
  shiftAssignments      ShiftAssignment[]
  attendancePunches     AttendancePunch[]
  attendanceDays        AttendanceDay[]
  attendanceCorrections AttendanceCorrection[]
  holidayCalendars      HolidayCalendar[]
  holidays              Holiday[]
  leaveTypes            LeaveType[]
  leaveLedger           LeaveLedgerEntry[]
  leaveRequests         LeaveRequest[]
  employeeChanges       EmployeeChangeRequest[]

  @@map("tenant")
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED

  @@map("membership_status")
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED

  @@map("audit_outcome")
}

enum TokenPurpose {
  PASSWORD_RESET
  INVITATION

  @@map("token_purpose")
}

/// Organisation records are archived, never deleted, so history and references stay intact.
enum RecordStatus {
  ACTIVE
  ARCHIVED

  @@map("record_status")
}

/// Where a role assignment applies. TENANT covers everything; COMPANY covers its branches and departments;
/// DEPARTMENT covers its sub-departments.
enum ScopeType {
  TENANT
  COMPANY
  BRANCH
  DEPARTMENT

  @@map("scope_type")
}

/// A login identity. Global, not tenant-owned: one person can belong to several tenants.
/// Deliberately separate from the employee record (Phase 8), which a user may later be linked to.
model User {
  id                   String                @id @default(uuid(7)) @db.Uuid
  /// Normalised to lower case before storage.
  email                String                @unique
  displayName          String                @map("display_name")
  /// argon2id hash. Null for SSO-only accounts.
  passwordHash         String?               @map("password_hash")
  status               UserStatus            @default(ACTIVE)
  isPlatformAdmin      Boolean               @default(false) @map("is_platform_admin")
  failedLoginCount     Int                   @default(0) @map("failed_login_count")
  lockedUntil          DateTime?             @map("locked_until") @db.Timestamptz(6)
  passwordChangedAt    DateTime?             @map("password_changed_at") @db.Timestamptz(6)
  lastLoginAt          DateTime?             @map("last_login_at") @db.Timestamptz(6)
  /// AES-256-GCM ciphertext of the TOTP secret; never stored in plain text.
  mfaTotpSecret        String?               @map("mfa_totp_secret")
  /// Secret awaiting confirmation during enrolment.
  mfaTotpPendingSecret String?               @map("mfa_totp_pending_secret")
  /// Last accepted TOTP time step, to reject replayed codes.
  mfaTotpLastStep      BigInt?               @map("mfa_totp_last_step")
  mfaEnabledAt         DateTime?             @map("mfa_enabled_at") @db.Timestamptz(6)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships          TenantMembership[]
  sessions             UserSession[]
  passwordResetTokens  PasswordResetToken[]
  recoveryCodes        MfaRecoveryCode[]
  notifications        Notification[]
  installedLicences    InstallationLicence[]

  @@map("app_user")
}

/// Grants a user access to a tenant. `isTenantAdmin` marks an organisation owner, who holds every permission;
/// everyone else gets permissions through role assignments.
model TenantMembership {
  id                  String               @id @default(uuid(7)) @db.Uuid
  tenantId            String               @map("tenant_id") @db.Uuid
  userId              String               @map("user_id") @db.Uuid
  status              MembershipStatus     @default(ACTIVE)
  isTenantAdmin       Boolean              @default(false) @map("is_tenant_admin")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments         RoleAssignment[]
  approvalRequests    ApprovalRequest[]    @relation("ApprovalRequester")
  approvalTasks       ApprovalTask[]       @relation("ApprovalAssignee")
  delegationsGiven    ApprovalDelegation[] @relation("DelegationFrom")
  delegationsReceived ApprovalDelegation[] @relation("DelegationTo")

  employee Employee?

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([userId])
  @@map("tenant_membership")
}

/// A legal entity inside a tenant.
model Company {
  id           String       @id @default(uuid(7)) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  code         String
  name         String
  legalName    String?      @map("legal_name")
  /// ISO 3166-1 alpha-2.
  country      String       @db.Char(2)
  /// ISO 4217.
  baseCurrency String       @map("base_currency") @db.Char(3)
  /// IANA time zone id, e.g. Asia/Kolkata.
  timezone     String
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branches     Branch[]
  departments  Department[]

  holidayCalendars HolidayCalendar[]
  employees        Employee[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@map("company")
}

/// A location of a company. References are tenant-qualified, so a branch can never point at another tenant's company.
model Branch {
  id        String       @id @default(uuid(7)) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  companyId String       @map("company_id") @db.Uuid
  code      String
  name      String
  city      String?
  /// ISO 3166-1 alpha-2.
  country   String?      @db.Char(2)
  /// IANA time zone id; defaults to the company's when not set.
  timezone  String?
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  company   Company      @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)

  holidayCalendars HolidayCalendar[]
  employees        Employee[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, companyId])
  @@map("branch")
}

/// A department of a company, optionally nested under a parent department of the same company.
model Department {
  id        String       @id @default(uuid(7)) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  companyId String       @map("company_id") @db.Uuid
  parentId  String?      @map("parent_id") @db.Uuid
  code      String
  name      String
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  company   Company      @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  parent    Department?  @relation("DepartmentTree", fields: [tenantId, parentId], references: [tenantId, id], onDelete: Restrict)
  children  Department[] @relation("DepartmentTree")

  employees Employee[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, companyId])
  @@index([tenantId, parentId])
  @@map("department")
}

/// A named set of permissions. System roles are created for every tenant and cannot be edited or deleted.
model Role {
  id          String           @id @default(uuid(7)) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  /// Stable machine name, unique in the tenant.
  key         String
  name        String
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  assignments RoleAssignment[]

  @@unique([tenantId, key])
  @@unique([tenantId, id])
  @@map("role")
}

/// One permission code in a role. Codes come from the catalogue in @smart-hr/shared and are validated by the API.
model RolePermission {
  tenantId   String @map("tenant_id") @db.Uuid
  roleId     String @map("role_id") @db.Uuid
  permission String
  role       Role   @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@id([roleId, permission])
  @@index([tenantId])
  @@map("role_permission")
}

/// Gives a member a role within a scope. For TENANT scope, scope_id is the tenant id.
model RoleAssignment {
  id              String           @id @default(uuid(7)) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  membershipId    String           @map("membership_id") @db.Uuid
  roleId          String           @map("role_id") @db.Uuid
  scopeType       ScopeType        @map("scope_type")
  scopeId         String           @map("scope_id") @db.Uuid
  createdByUserId String?          @map("created_by_user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  membership      TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  role            Role             @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)

  @@unique([membershipId, roleId, scopeType, scopeId])
  @@index([tenantId, roleId])
  @@map("role_assignment")
}

/// A server-side session. The browser holds only an opaque random token; this row holds its SHA-256 hash.
model UserSession {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  /// Synchronizer token for CSRF protection, echoed by the browser in a header.
  csrfToken         String    @map("csrf_token")
  activeTenantId    String?   @map("active_tenant_id") @db.Uuid
  /// True between a correct password and a correct second factor; such a session can do nothing else.
  mfaPending        Boolean   @default(false) @map("mfa_pending")
  reauthenticatedAt DateTime? @map("reauthenticated_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason      String?   @map("revoke_reason")
  ipAddress         String?   @map("ip_address")
  userAgent         String?   @map("user_agent")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeTenant      Tenant?   @relation(fields: [activeTenantId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("user_session")
}

/// Single-use token to set a password: a reset link, or an invitation to a new account. Only the SHA-256 hash is stored.
model PasswordResetToken {
  id        String       @id @default(uuid(7)) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  purpose   TokenPurpose @default(PASSWORD_RESET)
  tokenHash String       @unique @map("token_hash")
  expiresAt DateTime     @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?    @map("used_at") @db.Timestamptz(6)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_token")
}

/// Single-use MFA recovery code. Only the SHA-256 hash is stored.
model MfaRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_code")
}

/// Append-only record of security and business events. No foreign keys: audit outlives the records it describes.
/// UPDATE and DELETE are revoked from the runtime role and blocked by a trigger.
model AuditEvent {
  id          String       @id @default(uuid(7)) @db.Uuid
  occurredAt  DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(6)
  /// Null for platform-level events such as sign-in, which happen before a tenant is chosen.
  tenantId    String?      @map("tenant_id") @db.Uuid
  actorUserId String?      @map("actor_user_id") @db.Uuid
  action      String
  outcome     AuditOutcome
  targetType  String?      @map("target_type")
  targetId    String?      @map("target_id")
  ipAddress   String?      @map("ip_address")
  userAgent   String?      @map("user_agent")
  requestId   String?      @map("request_id")
  metadata    Json         @default("{}")

  @@index([tenantId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("audit_event")
}

/// Per-tenant configuration values. The first tenant-scoped table, used to prove RLS from day one.
model TenantSetting {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, key])
  @@map("tenant_setting")
}

// ---------------------------------------------------------------------------------------------
// Phase 4: notifications and the approval engine
// ---------------------------------------------------------------------------------------------

enum EmailDeliveryStatus {
  NOT_REQUESTED
  PENDING
  SENT
  FAILED

  @@map("email_delivery_status")
}

/// In-app notification for one person in one organisation. The row is also the email outbox: it is written in
/// the same transaction as the event, and the worker claims PENDING rows, so no email is lost if a process dies.
model Notification {
  id              String              @id @default(uuid(7)) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  recipientUserId String              @map("recipient_user_id") @db.Uuid
  category        String
  title           String
  body            String
  /// Relative path in the web app, e.g. /approvals/…
  link            String?
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt          DateTime?           @map("read_at") @db.Timestamptz(6)
  emailStatus     EmailDeliveryStatus @default(NOT_REQUESTED) @map("email_status")
  /// Snapshot of the recipient address when the notification was created.
  emailTo         String?             @map("email_to")
  emailSubject    String?             @map("email_subject")
  emailText       String?             @map("email_text")
  emailAttempts   Int                 @default(0) @map("email_attempts")
  emailClaimedAt  DateTime?           @map("email_claimed_at") @db.Timestamptz(6)
  emailSentAt     DateTime?           @map("email_sent_at") @db.Timestamptz(6)
  emailLastError  String?             @map("email_last_error")
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  recipient       User                @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([tenantId, recipientUserId, createdAt])
  @@index([emailStatus, emailClaimedAt])
  @@map("notification")
}

/// Per person, per organisation and category: whether to also send email. Absent row = default for the category.
model NotificationPreference {
  tenantId     String  @map("tenant_id") @db.Uuid
  userId       String  @map("user_id") @db.Uuid
  category     String
  emailEnabled Boolean @map("email_enabled")

  @@id([tenantId, userId, category])
  @@map("notification_preference")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  CANCELLED

  @@map("approval_status")
}

enum ApprovalTaskStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  SKIPPED
  CANCELLED

  @@map("approval_task_status")
}

/// A versioned approval policy for one kind of request. Published versions are never edited; a change creates
/// a new version and requests keep the version they started with.
model ApprovalPolicy {
  id              String            @id @default(uuid(7)) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  subjectType     String            @map("subject_type")
  version         Int
  name            String
  isActive        Boolean           @default(true) @map("is_active")
  /// Stages, approver rules and thresholds; validated by @smart-hr/validation before it is stored.
  definition      Json
  createdByUserId String?           @map("created_by_user_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  requests        ApprovalRequest[]

  @@unique([tenantId, subjectType, version])
  @@unique([tenantId, id])
  @@map("approval_policy")
}

/// One thing awaiting a decision, e.g. a leave request. Modules submit through the approval service.
model ApprovalRequest {
  id                      String           @id @default(uuid(7)) @db.Uuid
  tenantId                String           @map("tenant_id") @db.Uuid
  policyId                String           @map("policy_id") @db.Uuid
  subjectType             String           @map("subject_type")
  subjectId               String           @map("subject_id")
  title                   String
  amount                  Decimal?         @db.Decimal(19, 4)
  currency                String?          @db.Char(3)
  /// Where the subject sits in the organisation; approvers are resolved for this scope.
  scopeType               ScopeType        @map("scope_type")
  scopeId                 String           @map("scope_id") @db.Uuid
  requestedByMembershipId String           @map("requested_by_membership_id") @db.Uuid
  /// The employee the request is about, when there is one; "reporting manager" approvers are found from it.
  subjectEmployeeId       String?          @map("subject_employee_id") @db.Uuid
  status                  ApprovalStatus   @default(PENDING)
  /// Index into the policy's stages; meaningful while PENDING.
  currentStage            Int              @default(0) @map("current_stage")
  /// Increments when a returned request is resubmitted.
  round                   Int              @default(1)
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  decidedAt               DateTime?        @map("decided_at") @db.Timestamptz(6)
  policy                  ApprovalPolicy   @relation(fields: [tenantId, policyId], references: [tenantId, id], onDelete: Restrict)
  requestedBy             TenantMembership @relation("ApprovalRequester", fields: [tenantId, requestedByMembershipId], references: [tenantId, id], onDelete: Restrict)
  subjectEmployee         Employee?        @relation(fields: [tenantId, subjectEmployeeId], references: [tenantId, id], onDelete: Restrict)
  tasks                   ApprovalTask[]

  /// A subject has at most one approval request.
  @@unique([tenantId, subjectType, subjectId])
  @@unique([tenantId, id])
  @@index([tenantId, requestedByMembershipId, createdAt])
  @@index([tenantId, status])
  @@map("approval_request")
}

/// One approver's decision slot in one stage of a request.
model ApprovalTask {
  id                        String             @id @default(uuid(7)) @db.Uuid
  tenantId                  String             @map("tenant_id") @db.Uuid
  requestId                 String             @map("request_id") @db.Uuid
  round                     Int
  stage                     Int
  stageName                 String             @map("stage_name")
  assigneeMembershipId      String             @map("assignee_membership_id") @db.Uuid
  /// Set when the original approver had delegated to the assignee.
  delegatedFromMembershipId String?            @map("delegated_from_membership_id") @db.Uuid
  status                    ApprovalTaskStatus @default(PENDING)
  actedByMembershipId       String?            @map("acted_by_membership_id") @db.Uuid
  actedAt                   DateTime?          @map("acted_at") @db.Timestamptz(6)
  comment                   String?
  dueAt                     DateTime?          @map("due_at") @db.Timestamptz(6)
  escalatedAt               DateTime?          @map("escalated_at") @db.Timestamptz(6)
  createdAt                 DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  request                   ApprovalRequest    @relation(fields: [tenantId, requestId], references: [tenantId, id], onDelete: Cascade)
  assignee                  TenantMembership   @relation("ApprovalAssignee", fields: [tenantId, assigneeMembershipId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, assigneeMembershipId, status])
  @@index([tenantId, requestId])
  @@index([status, dueAt])
  @@map("approval_task")
}

/// "While I'm away, my approvals go to …". Applies to tasks created during the period.
model ApprovalDelegation {
  id               String           @id @default(uuid(7)) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  fromMembershipId String           @map("from_membership_id") @db.Uuid
  toMembershipId   String           @map("to_membership_id") @db.Uuid
  startsAt         DateTime         @map("starts_at") @db.Timestamptz(6)
  endsAt           DateTime         @map("ends_at") @db.Timestamptz(6)
  reason           String?
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt        DateTime?        @map("revoked_at") @db.Timestamptz(6)
  from             TenantMembership @relation("DelegationFrom", fields: [tenantId, fromMembershipId], references: [tenantId, id], onDelete: Cascade)
  to               TenantMembership @relation("DelegationTo", fields: [tenantId, toMembershipId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, fromMembershipId])
  @@map("approval_delegation")
}

// ---------------------------------------------------------------------------------------------
// Phase 4: master data

/// A value in one of the organisation's reference lists (employment types, designations, grades, …).
/// The lists themselves are defined in code (`MASTER_DATA_LISTS`); values are archived, never deleted,
/// so records that use them keep their meaning.
model LookupValue {
  id          String       @id @default(uuid(7)) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  list        String
  code        String
  name        String
  description String?
  sortOrder   Int          @default(0) @map("sort_order")
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  designationOf    Employee[] @relation("EmployeeDesignation")
  gradeOf          Employee[] @relation("EmployeeGrade")
  employmentTypeOf Employee[] @relation("EmployeeEmploymentType")
  costCentreOf     Employee[] @relation("EmployeeCostCentre")
  exitReasonOf     Employee[] @relation("EmployeeExitReason")

  @@unique([tenantId, list, code])
  @@unique([tenantId, id])
  @@index([tenantId, list, status, sortOrder])
  @@map("lookup_value")
}

// ---------------------------------------------------------------------------------------------
// Phase 5: plans, subscriptions and entitlements
//
// The catalogue (plan, plan_version, plan_price, addon, addon_price) is global platform data, written only
// by platform operators. A published plan version is immutable — a database trigger refuses changes — so a
// subscription always means what it meant when it was sold. Subscriptions and everything attached to them
// are tenant-owned and isolated by row-level security.
// ---------------------------------------------------------------------------------------------

enum PlanVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED

  @@map("plan_version_status")
}

enum BillingPeriod {
  MONTHLY
  ANNUAL

  @@map("billing_period")
}

enum PricingModel {
  PER_USER
  PER_EMPLOYEE
  FLAT

  @@map("pricing_model")
}

enum AddonKind {
  FEATURE
  CAPACITY
  SERVICE

  @@map("addon_kind")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  SUSPENDED
  EXPIRED

  @@map("subscription_status")
}

enum EntitlementOverrideKind {
  FEATURE
  LIMIT

  @@map("entitlement_override_kind")
}

/// A product plan, e.g. Pro. What it includes lives in its versions.
model Plan {
  id          String        @id @default(uuid(7)) @db.Uuid
  /// Stable code, e.g. PRO.
  code        String        @unique
  name        String
  description String?
  sortOrder   Int           @default(0) @map("sort_order")
  status      RecordStatus  @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  versions    PlanVersion[]

  @@map("plan")
}

/// One version of a plan's contents. Drafts are edited; published versions are frozen; retired versions are
/// no longer sold but keep serving existing subscriptions.
model PlanVersion {
  id               String            @id @default(uuid(7)) @db.Uuid
  planId           String            @map("plan_id") @db.Uuid
  version          Int
  status           PlanVersionStatus @default(DRAFT)
  /// Feature codes from @smart-hr/entitlements.
  features         String[]
  /// Limit code → number, or null for unlimited.
  limits           Json              @default("{}")
  trialDays        Int               @default(0) @map("trial_days")
  graceDays        Int               @default(14) @map("grace_days")
  supportLevel     String            @default("STANDARD") @map("support_level")
  /// SAAS, DEDICATED, IN_HOUSE.
  deploymentModels String[]          @map("deployment_models")
  notes            String?
  createdByUserId  String?           @map("created_by_user_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  publishedAt      DateTime?         @map("published_at") @db.Timestamptz(6)
  retiredAt        DateTime?         @map("retired_at") @db.Timestamptz(6)
  plan             Plan              @relation(fields: [planId], references: [id], onDelete: Restrict)
  prices           PlanPrice[]
  subscriptions    Subscription[]

  @@unique([planId, version])
  @@map("plan_version")
}

/// A list price for a plan version. Prices are set by operators; nothing is hard-coded.
model PlanPrice {
  id            String        @id @default(uuid(7)) @db.Uuid
  planVersionId String        @map("plan_version_id") @db.Uuid
  /// ISO 4217.
  currency      String        @db.Char(3)
  billingPeriod BillingPeriod @map("billing_period")
  pricingModel  PricingModel  @map("pricing_model")
  amount        Decimal       @db.Decimal(19, 4)
  planVersion   PlanVersion   @relation(fields: [planVersionId], references: [id], onDelete: Cascade)

  @@unique([planVersionId, currency, billingPeriod])
  @@map("plan_price")
}

/// Something sold on top of a plan: extra features, extra capacity, or a service (e.g. dedicated hosting).
model Addon {
  id            String              @id @default(uuid(7)) @db.Uuid
  code          String              @unique
  name          String
  description   String?
  kind          AddonKind
  features      String[]
  /// Limit increments per unit of quantity; null makes the limit unlimited.
  limits        Json                @default("{}")
  status        RecordStatus        @default(ACTIVE)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  prices        AddonPrice[]
  subscriptions SubscriptionAddon[]

  @@map("addon")
}

model AddonPrice {
  id            String        @id @default(uuid(7)) @db.Uuid
  addonId       String        @map("addon_id") @db.Uuid
  currency      String        @db.Char(3)
  billingPeriod BillingPeriod @map("billing_period")
  pricingModel  PricingModel  @map("pricing_model")
  amount        Decimal       @db.Decimal(19, 4)
  addon         Addon         @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@unique([addonId, currency, billingPeriod])
  @@map("addon_price")
}

/// The organisation's current subscription. Changes are recorded in subscription_event.
model Subscription {
  id                 String              @id @default(uuid(7)) @db.Uuid
  tenantId           String              @unique @map("tenant_id") @db.Uuid
  planVersionId      String              @map("plan_version_id") @db.Uuid
  status             SubscriptionStatus
  billingPeriod      BillingPeriod       @default(MONTHLY) @map("billing_period")
  currency           String              @default("INR") @db.Char(3)
  trialEndsAt        DateTime?           @map("trial_ends_at") @db.Timestamptz(6)
  currentPeriodStart DateTime?           @map("current_period_start") @db.Timestamptz(6)
  /// Null = open-ended (e.g. an annual contract invoiced offline and renewed by an operator).
  currentPeriodEnd   DateTime?           @map("current_period_end") @db.Timestamptz(6)
  graceEndsAt        DateTime?           @map("grace_ends_at") @db.Timestamptz(6)
  cancelledAt        DateTime?           @map("cancelled_at") @db.Timestamptz(6)
  /// Billing provider, e.g. `manual`. Card data is never stored here.
  provider           String              @default("manual")
  providerRef        String?             @map("provider_ref")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  planVersion        PlanVersion         @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  addons             SubscriptionAddon[]

  @@unique([tenantId, id])
  @@map("subscription")
}

model SubscriptionAddon {
  id             String       @id @default(uuid(7)) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  subscriptionId String       @map("subscription_id") @db.Uuid
  addonId        String       @map("addon_id") @db.Uuid
  quantity       Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  subscription   Subscription @relation(fields: [tenantId, subscriptionId], references: [tenantId, id], onDelete: Cascade)
  addon          Addon        @relation(fields: [addonId], references: [id], onDelete: Restrict)

  @@unique([subscriptionId, addonId])
  @@index([tenantId])
  @@map("subscription_addon")
}

/// A sales or support exception for one organisation: grant or remove a feature, or set a limit.
model EntitlementOverride {
  id              String                  @id @default(uuid(7)) @db.Uuid
  tenantId        String                  @map("tenant_id") @db.Uuid
  kind            EntitlementOverrideKind
  key             String
  /// FEATURE overrides: grant (true) or remove (false).
  enabled         Boolean?
  /// LIMIT overrides: exact value; null = unlimited.
  value           Int?
  reason          String
  expiresAt       DateTime?               @map("expires_at") @db.Timestamptz(6)
  createdByUserId String?                 @map("created_by_user_id") @db.Uuid
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt       DateTime?               @map("revoked_at") @db.Timestamptz(6)

  @@index([tenantId])
  @@map("entitlement_override")
}

/// Append-only history of subscription changes: the billing audit trail.
model SubscriptionEvent {
  id            String              @id @default(uuid(7)) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  action        String
  fromStatus    SubscriptionStatus? @map("from_status")
  toStatus      SubscriptionStatus? @map("to_status")
  planVersionId String?             @map("plan_version_id") @db.Uuid
  actorUserId   String?             @map("actor_user_id") @db.Uuid
  details       Json                @default("{}")
  occurredAt    DateTime            @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([tenantId, occurredAt])
  @@map("subscription_event")
}

// ---------------------------------------------------------------------------------------------
// Phase 6: self-service sign-up
// ---------------------------------------------------------------------------------------------

/// A pending self-service sign-up. Nothing is created until the person proves they own the email address by
/// opening the emailed link; only the SHA-256 hash of the link's token is stored.
model SignupRequest {
  id               String    @id @default(uuid(7)) @db.Uuid
  email            String
  displayName      String    @map("display_name")
  organisationName String    @map("organisation_name")
  tokenHash        String    @unique @map("token_hash")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(6)
  tenantId         String?   @map("tenant_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email])
  @@map("signup_request")
}

/// One row per installation, created by the migration. Its id binds an in-house licence to this installation.
model Installation {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("installation")
}

/// Signed licences installed on an in-house installation. The newest one without replaced_at applies.
model InstallationLicence {
  id                String    @id @default(uuid(7)) @db.Uuid
  licenceId         String    @unique @map("licence_id") @db.Uuid
  /// The signed licence exactly as issued; re-verified on every read.
  token             String
  customerName      String    @map("customer_name")
  planCode          String    @map("plan_code")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  installedAt       DateTime  @default(now()) @map("installed_at") @db.Timestamptz(6)
  installedByUserId String?   @map("installed_by_user_id") @db.Uuid
  replacedAt        DateTime? @map("replaced_at") @db.Timestamptz(6)

  installedBy User? @relation(fields: [installedByUserId], references: [id], onDelete: SetNull)

  @@index([replacedAt])
  @@map("installation_licence")
}

// ---------------------------------------------------------------------------------------------
// Phase 8: employees
// ---------------------------------------------------------------------------------------------

enum EmployeeStatus {
  ACTIVE
  /// Resigned or given notice; still employed until the last working day.
  ON_NOTICE
  EXITED

  @@map("employee_status")
}

enum Gender {
  FEMALE
  MALE
  NON_BINARY
  UNDISCLOSED

  @@map("gender")
}

enum EmployeeEventKind {
  JOINED
  TRANSFER
  PROMOTION
  MANAGER_CHANGE
  NOTICE
  NOTICE_WITHDRAWN
  EXIT

  @@map("employee_event_kind")
}

/// A person employed by one of the tenant's companies. Not every employee signs in: `membershipId` links
/// the record to a sign-in account when they have one. Every reference is tenant-qualified.
model Employee {
  id               String         @id @default(uuid(7)) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  employeeCode     String         @map("employee_code")
  membershipId     String?        @map("membership_id") @db.Uuid
  firstName        String         @map("first_name")
  lastName         String         @map("last_name")
  preferredName    String?        @map("preferred_name")
  workEmail        String?        @map("work_email")
  personalEmail    String?        @map("personal_email")
  phone            String?
  dateOfBirth      DateTime?      @map("date_of_birth") @db.Date
  gender           Gender?
  companyId        String         @map("company_id") @db.Uuid
  branchId         String?        @map("branch_id") @db.Uuid
  departmentId     String?        @map("department_id") @db.Uuid
  designationId    String?        @map("designation_id") @db.Uuid
  gradeId          String?        @map("grade_id") @db.Uuid
  employmentTypeId String?        @map("employment_type_id") @db.Uuid
  costCentreId     String?        @map("cost_centre_id") @db.Uuid
  managerId        String?        @map("manager_id") @db.Uuid
  dateOfJoining    DateTime       @map("date_of_joining") @db.Date
  probationEndDate DateTime?      @map("probation_end_date") @db.Date
  status           EmployeeStatus @default(ACTIVE)
  noticeGivenOn    DateTime?      @map("notice_given_on") @db.Date
  lastWorkingDay   DateTime?      @map("last_working_day") @db.Date
  exitReasonId     String?        @map("exit_reason_id") @db.Uuid
  exitedOn         DateTime?      @map("exited_on") @db.Date
  /// Optimistic concurrency: an update must name the version it was based on.
  version          Int            @default(1)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant                Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membership            TenantMembership?       @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict)
  company               Company                 @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  branch                Branch?                 @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  department            Department?             @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict)
  designation           LookupValue?            @relation("EmployeeDesignation", fields: [tenantId, designationId], references: [tenantId, id], onDelete: Restrict)
  grade                 LookupValue?            @relation("EmployeeGrade", fields: [tenantId, gradeId], references: [tenantId, id], onDelete: Restrict)
  employmentType        LookupValue?            @relation("EmployeeEmploymentType", fields: [tenantId, employmentTypeId], references: [tenantId, id], onDelete: Restrict)
  costCentre            LookupValue?            @relation("EmployeeCostCentre", fields: [tenantId, costCentreId], references: [tenantId, id], onDelete: Restrict)
  exitReason            LookupValue?            @relation("EmployeeExitReason", fields: [tenantId, exitReasonId], references: [tenantId, id], onDelete: Restrict)
  manager               Employee?               @relation("EmployeeManager", fields: [tenantId, managerId], references: [tenantId, id], onDelete: Restrict)
  reports               Employee[]              @relation("EmployeeManager")
  sensitive             EmployeeSensitive?
  events                EmployeeEvent[]
  emergencyContacts     EmergencyContact[]
  shiftAssignments      ShiftAssignment[]
  attendancePunches     AttendancePunch[]
  attendanceDays        AttendanceDay[]
  attendanceCorrections AttendanceCorrection[]
  leaveLedger           LeaveLedgerEntry[]
  changeRequests        EmployeeChangeRequest[]
  leaveRequests         LeaveRequest[]
  approvalRequests      ApprovalRequest[]

  @@unique([tenantId, id])
  @@unique([tenantId, employeeCode])
  @@unique([tenantId, membershipId])
  @@unique([tenantId, workEmail])
  @@index([tenantId, status])
  @@index([tenantId, companyId])
  @@index([tenantId, branchId])
  @@index([tenantId, departmentId])
  @@index([tenantId, managerId])
  @@map("employee")
}

/// Identity and bank details. Numbers are encrypted (AES-256-GCM, bound to the employee and field); only
/// the last four characters are stored in clear, for masked display.
model EmployeeSensitive {
  employeeId        String   @id @map("employee_id") @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  panSealed         String?  @map("pan_sealed")
  panLast4          String?  @map("pan_last4")
  aadhaarSealed     String?  @map("aadhaar_sealed")
  aadhaarLast4      String?  @map("aadhaar_last4")
  bankAccountSealed String?  @map("bank_account_sealed")
  bankAccountLast4  String?  @map("bank_account_last4")
  bankIfsc          String?  @map("bank_ifsc")
  bankName          String?  @map("bank_name")
  uan               String?
  updatedByUserId   String?  @map("updated_by_user_id") @db.Uuid
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, employeeId])
  @@map("employee_sensitive")
}

/// Append-only employment history: joining, transfers, promotions, manager changes, notice and exit.
model EmployeeEvent {
  id            String            @id @default(uuid(7)) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  employeeId    String            @map("employee_id") @db.Uuid
  kind          EmployeeEventKind
  effectiveDate DateTime          @map("effective_date") @db.Date
  /// Field → { from, to } with display names, as they were at the time.
  changes       Json              @default("{}")
  note          String?
  actorUserId   String?           @map("actor_user_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, employeeId, effectiveDate])
  @@map("employee_event")
}

model EmergencyContact {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  name         String
  relationship String
  phone        String
  email        String?
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, employeeId])
  @@map("emergency_contact")
}

/// Next automatic employee number per organisation (EMP-0001, EMP-0002, …).
model EmployeeCounter {
  tenantId   String @id @map("tenant_id") @db.Uuid
  nextNumber Int    @default(1) @map("next_number")

  @@map("employee_counter")
}

// ---- Attendance (Phase 9) ---------------------------------------------------------------------------

enum AttendanceDayStatus {
  PRESENT
  HALF_DAY
  ABSENT
  WEEKLY_OFF
  HOLIDAY
  ON_LEAVE

  @@map("attendance_day_status")
}

enum PunchDirection {
  IN
  OUT

  @@map("punch_direction")
}

enum PunchSource {
  /// The employee, from the web app.
  WEB
  /// Entered by someone with attendance.manage on the employee's behalf.
  ADMIN
  /// Written when a correction is approved.
  CORRECTION
  /// Uploaded from a file or a device export.
  IMPORT

  @@map("punch_source")
}

enum AttendanceCorrectionStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  CANCELLED

  @@map("attendance_correction_status")
}

/// A working pattern. Times are minutes after local midnight in the employee's time zone; an end before the
/// start means the shift crosses midnight.
model Shift {
  id             String       @id @default(uuid(7)) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  code           String
  name           String
  startMinute    Int          @map("start_minute")
  endMinute      Int          @map("end_minute")
  breakMinutes   Int          @default(0) @map("break_minutes")
  /// Arriving within this many minutes of the start isn't late.
  graceMinutes   Int          @default(10) @map("grace_minutes")
  /// Worked minutes needed for a half day and a full day.
  halfDayMinutes Int          @default(240) @map("half_day_minutes")
  fullDayMinutes Int          @default(480) @map("full_day_minutes")
  /// Days of the week that are off: 0 = Sunday … 6 = Saturday.
  weeklyOffs     Int[]        @default([0]) @map("weekly_offs")
  /// Used for employees with no assignment.
  isDefault      Boolean      @default(false) @map("is_default")
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assignments ShiftAssignment[]
  days        AttendanceDay[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("shift")
}

/// Which shift an employee works from a date onwards. The latest assignment on or before a day applies.
model ShiftAssignment {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  employeeId      String   @map("employee_id") @db.Uuid
  shiftId         String   @map("shift_id") @db.Uuid
  effectiveFrom   DateTime @map("effective_from") @db.Date
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)
  shift    Shift    @relation(fields: [tenantId, shiftId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, employeeId, effectiveFrom])
  @@index([tenantId, shiftId])
  @@map("shift_assignment")
}

/// One clock-in or clock-out. Append-only: mistakes are fixed by an approved correction, never by editing.
model AttendancePunch {
  id               String         @id @default(uuid(7)) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  employeeId       String         @map("employee_id") @db.Uuid
  at               DateTime       @db.Timestamptz(6)
  direction        PunchDirection
  source           PunchSource
  note             String?
  recordedByUserId String?        @map("recorded_by_user_id") @db.Uuid
  correctionId     String?        @map("correction_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee   Employee              @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)
  correction AttendanceCorrection? @relation(fields: [tenantId, correctionId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, employeeId, at])
  @@map("attendance_punch")
}

/// The computed result for one employee and local date. Recomputed whenever its punches, corrections or shift
/// change; days without a row are read as absent (working day in the past) or weekly off.
model AttendanceDay {
  id                String              @id @default(uuid(7)) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  employeeId        String              @map("employee_id") @db.Uuid
  date              DateTime            @db.Date
  shiftId           String?             @map("shift_id") @db.Uuid
  status            AttendanceDayStatus
  firstIn           DateTime?           @map("first_in") @db.Timestamptz(6)
  lastOut           DateTime?           @map("last_out") @db.Timestamptz(6)
  workedMinutes     Int                 @default(0) @map("worked_minutes")
  lateMinutes       Int                 @default(0) @map("late_minutes")
  earlyLeaveMinutes Int                 @default(0) @map("early_leave_minutes")
  overtimeMinutes   Int                 @default(0) @map("overtime_minutes")
  /// An approved correction contributed to this day.
  corrected         Boolean             @default(false)
  computedAt        DateTime            @default(now()) @map("computed_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)
  shift    Shift?   @relation(fields: [tenantId, shiftId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, employeeId, date])
  @@index([tenantId, date])
  @@map("attendance_day")
}

/// A request to fix a day's times (a forgotten clock-out, a device failure). Applied only once approved.
model AttendanceCorrection {
  id                String                     @id @default(uuid(7)) @db.Uuid
  tenantId          String                     @map("tenant_id") @db.Uuid
  employeeId        String                     @map("employee_id") @db.Uuid
  date              DateTime                   @db.Date
  inAt              DateTime?                  @map("in_at") @db.Timestamptz(6)
  outAt             DateTime?                  @map("out_at") @db.Timestamptz(6)
  reason            String
  status            AttendanceCorrectionStatus @default(PENDING)
  approvalRequestId String?                    @map("approval_request_id") @db.Uuid
  requestedByUserId String                     @map("requested_by_user_id") @db.Uuid
  decisionNote      String?                    @map("decision_note")
  decidedAt         DateTime?                  @map("decided_at") @db.Timestamptz(6)
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee Employee          @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)
  punches  AttendancePunch[]

  @@unique([tenantId, id])
  @@index([tenantId, employeeId, date])
  @@index([tenantId, status])
  @@map("attendance_correction")
}

// ---- Holidays and leave (Phase 10) ------------------------------------------------------------------

enum LeaveAccrual {
  /// The year's quota is credited at the start of the year (pro-rated for people who join during it).
  YEARLY
  /// One twelfth of the quota is credited each month.
  MONTHLY
  /// No balance is kept (for example unpaid leave); only requests and approvals.
  NONE

  @@map("leave_accrual")
}

enum LeaveLedgerKind {
  GRANT
  ACCRUAL
  CARRY_FORWARD
  LAPSE
  ADJUSTMENT
  TAKEN
  REVERSAL

  @@map("leave_ledger_kind")
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  CANCELLED

  @@map("leave_request_status")
}

enum HalfDay {
  FIRST_HALF
  SECOND_HALF

  @@map("half_day")
}

/// A set of public holidays. One calendar per place: the whole organisation, a company or a branch. An
/// employee follows their branch's calendar, else their company's, else the organisation's.
model HolidayCalendar {
  id        String       @id @default(uuid(7)) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  name      String
  companyId String?      @map("company_id") @db.Uuid
  branchId  String?      @map("branch_id") @db.Uuid
  /// "TENANT", "COMPANY:<id>" or "BRANCH:<id>": makes "one calendar per place" a unique constraint.
  scopeKey  String       @map("scope_key")
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company  Company?  @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  branch   Branch?   @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  holidays Holiday[]

  @@unique([tenantId, id])
  @@unique([tenantId, scopeKey])
  @@map("holiday_calendar")
}

model Holiday {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  calendarId String   @map("calendar_id") @db.Uuid
  date       DateTime @db.Date
  name       String
  /// A restricted holiday: shown on the calendar, but a working day unless the employee takes leave.
  optional   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  calendar HolidayCalendar @relation(fields: [tenantId, calendarId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, calendarId, date])
  @@index([tenantId, date])
  @@map("holiday")
}

model LeaveType {
  id                    String       @id @default(uuid(7)) @db.Uuid
  tenantId              String       @map("tenant_id") @db.Uuid
  code                  String
  name                  String
  description           String?
  paid                  Boolean      @default(true)
  accrual               LeaveAccrual @default(YEARLY)
  /// Days per year (YEARLY and MONTHLY).
  quotaDays             Decimal      @default(0) @map("quota_days") @db.Decimal(5, 1)
  /// Unused days that move into the next year; the rest lapse.
  carryForwardMaxDays   Decimal      @default(0) @map("carry_forward_max_days") @db.Decimal(5, 1)
  allowHalfDay          Boolean      @default(true) @map("allow_half_day")
  /// Count weekly offs and holidays inside a request as leave days.
  includeNonWorkingDays Boolean      @default(false) @map("include_non_working_days")
  /// Requests for oneself must be made this many days ahead (0 = any time, including afterwards).
  minNoticeDays         Int          @default(0) @map("min_notice_days")
  /// Longest single request in days; null = no limit.
  maxDaysPerRequest     Int?         @map("max_days_per_request")
  status                RecordStatus @default(ACTIVE)
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  ledger   LeaveLedgerEntry[]
  requests LeaveRequest[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("leave_type")
}

/// Every change to a leave balance, append-only. A balance is the sum of its year's entries.
model LeaveLedgerEntry {
  id              String          @id @default(uuid(7)) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  employeeId      String          @map("employee_id") @db.Uuid
  leaveTypeId     String          @map("leave_type_id") @db.Uuid
  year            Int
  kind            LeaveLedgerKind
  /// Positive credits, negative debits, in days (half days allowed).
  days            Decimal         @db.Decimal(6, 1)
  /// Makes automatic credits idempotent: "2026" for a yearly grant, "2026-03" for March's accrual.
  periodKey       String?         @map("period_key")
  requestId       String?         @map("request_id") @db.Uuid
  note            String?
  createdByUserId String?         @map("created_by_user_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee  Employee      @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)
  leaveType LeaveType     @relation(fields: [tenantId, leaveTypeId], references: [tenantId, id], onDelete: Restrict)
  request   LeaveRequest? @relation(fields: [tenantId, requestId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, employeeId, leaveTypeId, kind, periodKey], map: "leave_ledger_entry_period_key_key")
  @@index([tenantId, employeeId, leaveTypeId, year])
  @@map("leave_ledger_entry")
}

model LeaveRequest {
  id                String             @id @default(uuid(7)) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  employeeId        String             @map("employee_id") @db.Uuid
  leaveTypeId       String             @map("leave_type_id") @db.Uuid
  fromDate          DateTime           @map("from_date") @db.Date
  toDate            DateTime           @map("to_date") @db.Date
  /// Only for one-day requests: which half of the day is taken.
  halfDay           HalfDay?           @map("half_day")
  days              Decimal            @db.Decimal(5, 1)
  reason            String
  status            LeaveRequestStatus @default(PENDING)
  approvalRequestId String?            @map("approval_request_id") @db.Uuid
  requestedByUserId String             @map("requested_by_user_id") @db.Uuid
  decisionNote      String?            @map("decision_note")
  decidedAt         DateTime?          @map("decided_at") @db.Timestamptz(6)
  cancelledByUserId String?            @map("cancelled_by_user_id") @db.Uuid
  cancelledAt       DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee  Employee           @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)
  leaveType LeaveType          @relation(fields: [tenantId, leaveTypeId], references: [tenantId, id], onDelete: Restrict)
  ledger    LeaveLedgerEntry[]

  @@unique([tenantId, id])
  @@index([tenantId, employeeId, fromDate])
  @@index([tenantId, status])
  @@map("leave_request")
}

// ---- Employment changes for approval (Phase 11) -----------------------------------------------------

enum EmployeeChangeStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  CANCELLED

  @@map("employee_change_status")
}

/// A promotion, transfer, manager change, notice or exit waiting for approval. Applied (and written to the
/// employee's history) only when approved; checked again at that moment.
model EmployeeChangeRequest {
  id                String               @id @default(uuid(7)) @db.Uuid
  tenantId          String               @map("tenant_id") @db.Uuid
  employeeId        String               @map("employee_id") @db.Uuid
  /// transfer, promotion, change_manager, notice, withdraw_notice or exit.
  action            String
  /// The change as requested (validated input).
  payload           Json
  /// What would change, worked out when requested: { field: { from, to } }.
  changes           Json
  effectiveDate     DateTime             @map("effective_date") @db.Date
  note              String?
  status            EmployeeChangeStatus @default(PENDING)
  approvalRequestId String?              @map("approval_request_id") @db.Uuid
  requestedByUserId String               @map("requested_by_user_id") @db.Uuid
  decisionNote      String?              @map("decision_note")
  decidedAt         DateTime?            @map("decided_at") @db.Timestamptz(6)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, employeeId, status])
  @@map("employee_change_request")
}
