# In-house installation settings. Copy to .env, replace every CHANGE_ME, and keep .env readable by root only:
#   chmod 600 .env
# Never commit .env or send it to anyone, including Smartclues support.

SMART_HR_VERSION=CHANGE_ME
# Where the images were loaded or pulled from (docker load / your internal registry).
IMAGE_REGISTRY=smart-hr

# The address people type into their browser, behind your TLS proxy.
APP_PUBLIC_URL=https://hr.example.internal
# Host addresses the containers listen on. Keep them on 127.0.0.1 when the proxy runs on this server.
WEB_BIND=127.0.0.1:3000
API_BIND=127.0.0.1:4000
# Set when web and API are on sibling subdomains, e.g. .example.internal
AUTH_COOKIE_DOMAIN=

# Database passwords: long random values, e.g.  openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME
MIGRATOR_DB_PASSWORD=CHANGE_ME
APP_DB_PASSWORD=CHANGE_ME

# Encrypts two-step verification secrets. Generate once and back it up with the database:
#   echo "k1:$(openssl rand -base64 32)"
MFA_ENCRYPTION_KEYS=CHANGE_ME
MFA_ENCRYPTION_KEY_ID=k1

# Public licence-verification keys supplied by Smartclues with your licence (not secret).
LICENCE_PUBLIC_KEYS=CHANGE_ME

# Your mail relay.
SMTP_URL=smtp://mail.example.internal:25
MAIL_FROM=Smart HR <hr-no-reply@example.internal>

LOG_LEVEL=info
