{
  "name": "@smart-hr/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --env-file-if-exists=../../.env dist/main.js)",
    "start": "node dist/main.js",
    "healthcheck": "node dist/healthcheck.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit --passWithNoTests",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@smart-hr/config": "workspace:*",
    "@smart-hr/database": "workspace:*",
    "@smart-hr/observability": "workspace:*",
    "@smart-hr/shared": "workspace:*",
    "bullmq": "6.3.13",
    "ioredis": "6.0.0",
    "nodemailer": "10.1.0",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@swc/core": "1.16.18",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.4"
  }
}
