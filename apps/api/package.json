{
  "name": "@smart-hr/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --env-file-if-exists=../../.env dist/main.js)",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "bootstrap:tenant": "node --env-file-if-exists=../../.env dist/cli/bootstrap.js",
    "sync:system-roles": "node --env-file-if-exists=../../.env dist/cli/sync-system-roles.js",
    "sync:plan-catalogue": "node --env-file-if-exists=../../.env dist/cli/sync-plan-catalogue.js"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@smart-hr/auth": "workspace:*",
    "@smart-hr/config": "workspace:*",
    "@smart-hr/database": "workspace:*",
    "@smart-hr/entitlements": "workspace:*",
    "@smart-hr/observability": "workspace:*",
    "@smart-hr/shared": "workspace:*",
    "@smart-hr/validation": "workspace:*",
    "bullmq": "6.3.13",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.3",
    "@swc/core": "1.16.18",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.4"
  }
}
