# Copy to .env for local development. Never commit real secrets.

NODE_ENV=development
LOG_LEVEL=debug

# saas | dedicated | inhouse
DEPLOYMENT_MODE=saas

# API
API_PORT=4000
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Public URL of the web app, used in emailed links
APP_PUBLIC_URL=http://localhost:3000

# PostgreSQL — the API runs as the restricted app role; migrations use the migrator role.
DATABASE_URL=postgresql://app_rw:app_rw_local@localhost:5432/smart_hr
DATABASE_MIGRATOR_URL=postgresql://app_migrator:app_migrator_local@localhost:5432/smart_hr
SHADOW_DATABASE_URL=postgresql://app_migrator:app_migrator_local@localhost:5432/smart_hr_shadow

# Redis (sessions rate limits, BullMQ). API and worker must use the same QUEUE_PREFIX.
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=smarthr

# Authentication (see docs/security/AUTHENTICATION.md for every option)
# Local HTTP only — production forces Secure cookies.
AUTH_COOKIE_SECURE=false
# Generate your own key:  echo "local:$(openssl rand -base64 32)"
MFA_ENCRYPTION_KEYS=
MFA_ENCRYPTION_KEY_ID=local

# Email (worker). Mailpit from docker compose catches everything at http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Smart HR <no-reply@localhost>

# S3-compatible storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=smart-hr-documents-local
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio-local-only

# Web (only NEXT_PUBLIC_* values reach the browser)
NEXT_PUBLIC_API_URL=http://localhost:4000
